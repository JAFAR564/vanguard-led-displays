# Lead delivery — configure one transport in production.
# With NODE_ENV=production and none configured, /api/enquiry returns 503
# instead of accepting an enquiry it cannot deliver.

# Option 1: webhook (CRM, Slack, Make, n8n, Zapier…)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Option 2: transactional email via Resend
RESEND_API_KEY=
LEAD_TO_EMAIL=quotes@leddisplays.co.za
LEAD_FROM_EMAIL=website@leddisplays.co.za

# Extra origin hosts allowed to POST (comma separated). The request host is
# always allowed, so a single-domain deployment needs none.
ALLOWED_ORIGINS=

# Backup ledger directory (defaults to ./data, or /tmp on Vercel).
LEAD_STORE_DIR=

# Set to "false" only if you intentionally accept enquiries without delivery.
REQUIRE_LEAD_DELIVERY=true
