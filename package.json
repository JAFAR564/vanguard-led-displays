{
  "name": "south-african-led-displays",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/astro/astro.js dev",
    "start": "node ./node_modules/astro/astro.js dev",
    "build": "node ./node_modules/@astrojs/check/bin/astro-check.js && node ./node_modules/astro/astro.js build",
    "preview": "node ./node_modules/astro/astro.js preview",
    "serve": "HOST=0.0.0.0 PORT=4321 node ./dist/server/entry.mjs",
    "leads": "node ./scripts/view-leads.mjs",
    "extract-frames": "node ./scripts/extract-frames.mjs",
    "astro": "node ./node_modules/astro/astro.js"
  },
  "dependencies": {
    "@astrojs/node": "^9.4.6",
    "astro": "^5.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^26.6.5",
    "typescript": "^5.8.2"
  }
}
