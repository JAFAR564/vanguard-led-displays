---
---

<section class="section section--advertise" id="advertise" aria-labelledby="advertise-heading">
  <div class="container">
    <div class="advertise-container">
      <div class="advertise-header">
        <span class="badge advertise-badge">Media Buyers & Regional Brands</span>
        <h2 id="advertise-heading" class="advertise-title">
          Advertise on Our LED Display Network
        </h2>
        <p class="advertise-desc">
          Reach affluent residential homeowners, daily commuters, and high-dwell retail shoppers in George, the Garden Route, and high-growth Western Cape nodes. Enquire below for slot availability, loop frequency, and current rate cards.
        </p>
      </div>

      <!-- Compact 5-Field Advertising Form -->
      <form id="advertising-enquiry-form" method="POST" action="/api/enquiry" class="advertise-form" novalidate>
        <!-- Honeypot -->
        <div style="display:none !important;" aria-hidden="true">
          <input type="text" name="company_website_url" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="formType" value="advertising_enquiry" />
        </div>

        <div class="advertise-grid">
          <!-- 1. Full Name -->
          <div class="field-group">
            <label for="advName">Contact Name <span class="required-star">*</span></label>
            <input type="text" id="advName" name="advName" autocomplete="name" placeholder="e.g. Sarah Smit" required />
            <span class="field-error" id="advNameError" aria-live="polite"></span>
          </div>

          <!-- 2. Business / Agency -->
          <div class="field-group">
            <label for="advCompany">Business or Agency Name <span class="required-star">*</span></label>
            <input type="text" id="advCompany" name="advCompany" autocomplete="organization" placeholder="e.g. Outeniqua Media / Local Business" required />
            <span class="field-error" id="advCompanyError" aria-live="polite"></span>
          </div>

          <!-- 3. Phone -->
          <div class="field-group">
            <label for="advPhone">Phone Number <span class="required-star">*</span></label>
            <input type="tel" id="advPhone" name="advPhone" inputmode="tel" autocomplete="tel" placeholder="e.g. 082 123 4567" required />
            <span class="field-error" id="advPhoneError" aria-live="polite"></span>
          </div>

          <!-- 4. Email -->
          <div class="field-group">
            <label for="advEmail">Work Email Address <span class="required-star">*</span></label>
            <input type="email" id="advEmail" name="advEmail" inputmode="email" autocomplete="email" placeholder="e.g. media@agency.co.za" required />
            <span class="field-error" id="advEmailError" aria-live="polite"></span>
          </div>

          <!-- 5. Campaign Notes (Spans full width) -->
          <div class="field-group field-group--full">
            <label for="advNotes">Target Location, Campaign Month, or Slot Requirements (Optional)</label>
            <textarea id="advNotes" name="advNotes" rows="2" placeholder="e.g. Requesting George estate entrance rate card for Q1 campaign."></textarea>
          </div>
        </div>

        <div class="advertise-footer">
          <p class="advertise-terms">
            Screen advertising content is subject to estate HOA and municipal approval. Prohibited categories include alcohol, political campaigning, and unverified financial services.
          </p>
          <button type="submit" id="submit-adv-btn" class="btn btn-secondary advertise-btn">
            Request Media Kit & Rate Card
          </button>
        </div>
      </form>

      <!-- In-Place Success Panel -->
      <div id="adv-success-panel" class="adv-success-panel" hidden aria-live="polite">
        <div class="adv-success-badge" aria-hidden="true">✓</div>
        <h3>Media Enquiry Received</h3>
        <p>Thank you. Our media sales team will dispatch current screen location metrics, audience footfall data, and rate cards to your email within one business day.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const advForm = document.getElementById('advertising-enquiry-form') as HTMLFormElement | null;
  const advSuccess = document.getElementById('adv-success-panel');
  const advBtn = document.getElementById('submit-adv-btn') as HTMLButtonElement | null;

  if (advForm) {
    advForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear errors
      advForm.querySelectorAll('.field-error').forEach(el => (el.textContent = ''));

      const formData = new FormData(advForm);
      const name = (formData.get('advName') as string || '').trim();
      const company = (formData.get('advCompany') as string || '').trim();
      const phone = (formData.get('advPhone') as string || '').trim();
      const email = (formData.get('advEmail') as string || '').trim();

      let hasError = false;
      if (!name) {
        setAdvError('advName', 'Please provide your name.');
        hasError = true;
      }
      if (!company) {
        setAdvError('advCompany', 'Please provide your business or agency name.');
        hasError = true;
      }
      let cleanedPhone = phone.replace(/[\s\-\(\)\.]/g, '');
      if (cleanedPhone.startsWith('0027')) cleanedPhone = '+27' + cleanedPhone.slice(4);
      if (cleanedPhone.startsWith('+270')) cleanedPhone = '+27' + cleanedPhone.slice(4);
      else if (cleanedPhone.startsWith('270')) cleanedPhone = '+27' + cleanedPhone.slice(3);

      const saPhoneRegex = /^(?:\+27|27|0)[1-8][0-9]{8}$/;
      if (!cleanedPhone || !saPhoneRegex.test(cleanedPhone)) {
        setAdvError('advPhone', 'Please enter a valid South African phone number (e.g. 082 123 4567).');
        hasError = true;
      }
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!email || !emailRegex.test(email)) {
        setAdvError('advEmail', 'Please enter a valid work email.');
        hasError = true;
      }

      if (hasError) return;

      if (advBtn) {
        advBtn.disabled = true;
        advBtn.textContent = 'Sending Request...';
      }

      try {
        const res = await fetch('/api/enquiry', {
          method: 'POST',
          body: formData,
        });
        const data = await res.json();
        if (res.ok && data.success) {
          advForm.hidden = true;
          if (advSuccess) {
            advSuccess.hidden = false;
            advSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        } else {
          alert('Submission error. Please reach out to ' + 'advertise@leddisplays.co.za');
        }
      } catch (err) {
        alert('Connection error. Please email us directly at ' + 'advertise@leddisplays.co.za');
      } finally {
        if (advBtn) {
          advBtn.disabled = false;
          advBtn.textContent = 'Request Media Kit & Rate Card';
        }
      }
    });
  }

  function setAdvError(fieldId: string, msg: string) {
    const errorEl = document.getElementById(`${fieldId}Error`);
    if (errorEl) errorEl.textContent = msg;
  }
</script>

<style>
  .section--advertise {
    padding-block: clamp(3rem, 5vw, 4.5rem);
    background-color: var(--color-bg-primary);
  }

  .advertise-container {
    background-color: var(--color-bg-subtle);
    border: 2px solid var(--color-text-primary);
    border-radius: var(--radius-lg);
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow: var(--shadow-card);
  }

  .advertise-header {
    margin-bottom: 2rem;
  }

  .advertise-badge {
    background-color: var(--color-bg-primary);
    color: var(--color-text-primary);
    border-color: var(--color-border-input);
    margin-bottom: 0.75rem;
  }

  .advertise-title {
    font-size: var(--font-size-h2);
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .advertise-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 68ch;
  }

  .advertise-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .advertise-grid {
      grid-template-columns: 1fr;
    }
  }

  .field-group--full {
    grid-column: 1 / -1;
  }

  .required-star {
    color: var(--color-error);
  }

  .advertise-footer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 768px) {
    .advertise-footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .advertise-terms {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: 55ch;
  }

  .advertise-btn {
    flex-shrink: 0;
  }

  .adv-success-panel {
    text-align: center;
    padding: 2rem;
  }

  .adv-success-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: var(--color-success-bg);
    border: 2px solid var(--color-success-border);
    color: var(--color-success);
    font-size: 1.5rem;
    font-weight: 700;
    border-radius: var(--radius-full);
    margin-bottom: 1rem;
  }

  .adv-success-panel h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .adv-success-panel p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    max-width: 50ch;
    margin-inline: auto;
  }
</style>
