---
import { Image } from 'astro:assets';
import { siteConfig } from '../config/site';
import riggingImage from '../assets/rigging.jpg';
import commercialImage from '../assets/application-commercial.jpg';

const { applications } = siteConfig;
---

<section class="section applications" id="applications" aria-labelledby="applications-heading">
  <div class="container">
    <div class="split split--4-8 sections__head">
      <div>
        <p class="section__index">
          <span>{applications.index}</span>
          <span>{applications.eyebrow}</span>
        </p>
        <h2 id="applications-heading">{applications.heading}</h2>
      </div>
      <div class="applications__intro">
        <p class="section__lede">{applications.lede}</p>
        <p class="applications__thesis mono">{applications.thesis}</p>
      </div>
    </div>

    <div class="applications__diptych split split--5-7">
      <figure class="plate">
        <div class="plate__frame plate__frame--rig">
          <Image
            src={riggingImage}
            alt={applications.plates.rigging.alt}
            widths={[420, 640, 900]}
            sizes="(max-width: 1023px) 92vw, 40vw"
            loading="lazy"
          />
        </div>
        <figcaption class="applications__caption">{applications.plates.rigging.caption}</figcaption>
      </figure>

      <figure class="plate">
        <div class="plate__frame plate__frame--commercial">
          <Image
            src={commercialImage}
            alt={applications.plates.commercial.alt}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 1023px) 92vw, 56vw"
            loading="lazy"
          />
        </div>
        <figcaption class="applications__caption">
          {applications.plates.commercial.caption}
        </figcaption>
      </figure>
    </div>

    <ul class="applications__list" role="list">
      {applications.items.map((item) => (
        <li class="applications__item">
          <p class="applications__index mono">Application {item.index}</p>
          <h3 class="applications__title">{item.title}</h3>
          <p class="applications__body">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sections__head {
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .applications__intro {
    display: grid;
    gap: 18px;
    padding-top: 6px;
  }

  .applications__thesis {
    margin: 0;
    max-width: 58ch;
    line-height: 1.6;
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--text-2);
  }

  /*
     Asymmetric diptych: the finished installation carries the section at 7 of 12
     columns, the rigging detail sits beside it at 5. Both frames share one height
     so the captions land on a single baseline — the plates read as a spread rather
     than two thumbnails. Plate numbers stay in narrative order (02 detail, 03
     finished), so the eye travels from the work to the result.
  */
  .applications__diptych {
    align-items: start;
    --plate-h: clamp(232px, 30vw, 430px);
  }

  .plate__frame--rig,
  .plate__frame--commercial {
    height: var(--plate-h);
  }

  /* The rigging frame is portrait-cropped from a 4:3 source. Holding it at
     88% keeps the installer, the ladder and the open cabinet row in shot. */
  .plate__frame--rig img {
    object-position: 88% 50%;
  }

  .plate__frame--commercial img {
    object-position: 50% 48%;
  }

  .applications__caption {
    margin-top: 0;
    padding-top: 9px;
    border-top: 1px solid var(--rule);
    align-items: baseline;
  }

  .applications__caption::before {
    margin-top: 4px;
    flex: 0 0 14px;
  }

  .applications__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  .applications__item {
    padding: 24px clamp(20px, 2.4vw, 32px) 8px 0;
    border-right: 1px solid var(--rule);
  }

  .applications__item:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .applications__item:not(:first-child) {
    padding-left: clamp(20px, 2.4vw, 32px);
  }

  .applications__index {
    margin: 0 0 14px;
  }

  .applications__title {
    font-size: var(--step-2);
    max-width: 16ch;
  }

  .applications__body {
    margin-top: 12px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  @media (max-width: 1023px) {
    .applications__diptych {
      --plate-h: auto;
      row-gap: clamp(24px, 5vw, 40px);
    }
    .plate__frame--rig,
    .plate__frame--commercial {
      height: auto;
      aspect-ratio: 3 / 2;
    }
    .applications__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .applications__item {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
      padding: 22px 0;
    }
    .applications__item:not(:first-child) {
      padding-left: 0;
    }
  }
</style>
