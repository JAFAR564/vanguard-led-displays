---
import { siteConfig } from '../config/site';

const { commercial } = siteConfig;
---

<section class="section commercial" id="commercial" aria-labelledby="commercial-heading">
  <div class="container">
    <div class="split split--4-8 commercial__head">
      <div>
        <p class="section__index">
          <span>{commercial.index}</span>
          <span>{commercial.eyebrow}</span>
        </p>
        <h2 id="commercial-heading">{commercial.heading}</h2>
      </div>
      <div>
        <p class="section__lede">{commercial.lede}</p>
      </div>
    </div>

    <div class="commercial__models split split--6-6">
      {commercial.models.map((model) => (
        <article class="model">
          <div class="model__head">
            <span class="mono model__num">{model.num}</span>
            <h3 class="model__title">{model.title}</h3>
          </div>
          <p class="model__body">{model.body}</p>
          <p class="model__best">
            <span class="mono">Best for</span>
            {model.bestFor}
          </p>
          <ul class="model__points" role="list">
            {model.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <p class="commercial__note small">{commercial.note}</p>
  </div>
</section>

<style>
  .commercial__head {
    margin-bottom: clamp(36px, 4vw, 56px);
  }

  .commercial__models {
    border-top: 1px solid var(--rule-strong);
  }

  .model {
    padding: clamp(22px, 2.6vw, 32px) clamp(20px, 2.4vw, 32px) clamp(20px, 2.4vw, 28px) 0;
    border-right: 1px solid var(--rule);
  }

  .model:last-child {
    border-right: 0;
    padding-right: 0;
    padding-left: clamp(20px, 2.4vw, 32px);
  }

  .model__head {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .model__num {
    color: var(--accent-text);
  }

  .model__title {
    font-size: var(--step-2);
  }

  .model__body {
    margin-top: 14px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 46ch;
  }

  .model__best {
    margin-top: 18px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-1);
  }

  .model__best .mono {
    display: block;
    margin-bottom: 4px;
  }

  .model__points {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 18px 0 0;
    padding: 0;
  }

  .model__points li {
    padding: 3px 8px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--text-2);
  }

  .commercial__note {
    max-width: 76ch;
    margin-top: clamp(24px, 3vw, 32px);
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 1023px) {
    .commercial__models {
      border-top: 0;
    }
    .model,
    .model:last-child {
      padding: 22px 0;
      border-right: 0;
      border-top: 1px solid var(--rule-strong);
    }
  }
</style>
