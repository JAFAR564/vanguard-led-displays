---
import { siteConfig } from '../config/site';

const { faqs } = siteConfig;
---

<section class="section faq" id="questions" aria-labelledby="questions-heading">
  <div class="container">
    <div class="split split--4-8 faq__split">
      <div class="faq__aside sticky-host">
        <div class="sticky">
          <p class="section__index">
            <span>07</span>
            <span>Questions</span>
          </p>
          <h2 id="questions-heading">Asked before the quote.</h2>
          <p class="faq__lede">
            The questions trustees, managing agents and asset managers raise in the first meeting.
            If yours is not here, ask it directly.
          </p>
          <a class="arrow-link faq__contact" href={`mailto:${siteConfig.contact.emailQuote}`}>
            {siteConfig.contact.emailQuote}
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.25"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="faq__list">
        {faqs.map((faq, index) => (
          <details class="faq__item" name="faq">
            <summary class="faq__summary">
              <span class="faq__num numeric">{String(index + 1).padStart(2, '0')}</span>
              <span class="faq__question">{faq.question}</span>
              <span class="faq__icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none">
                  <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.1" />
                </svg>
              </span>
            </summary>
            <div class="faq__answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq__lede {
    margin-top: 18px;
    max-width: 34ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  .faq__contact {
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
  }

  .faq__list {
    border-top: 1px solid var(--rule-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--rule-strong);
  }

  .faq__summary {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 24px;
    align-items: start;
    gap: 14px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
    min-height: 44px;
  }

  .faq__summary::-webkit-details-marker {
    display: none;
  }

  .faq__num {
    font-size: 11px;
    color: var(--text-3);
    padding-top: 5px;
  }

  .faq__question {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--text-1);
    transition: color var(--fast) var(--ease);
  }

  .faq__summary:hover .faq__question {
    color: var(--accent-text);
  }

  .faq__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-top: 2px;
    color: var(--text-2);
  }

  .faq__icon svg {
    width: 14px;
    height: 14px;
    transition: transform var(--normal) var(--ease);
  }

  .faq__item[open] .faq__icon svg {
    transform: rotate(45deg);
  }

  .faq__answer {
    padding: 0 34px 22px 48px;
  }

  .faq__answer p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--text-2);
    max-width: 66ch;
  }

  @media (max-width: 560px) {
    .faq__summary {
      grid-template-columns: 26px minmax(0, 1fr) 20px;
      gap: 10px;
    }
    .faq__answer {
      padding: 0 0 20px 36px;
    }
  }
</style>
