---
import { Image } from 'astro:assets';
import { siteConfig } from '../config/site';
import heroImage from '../assets/hero-estate.jpg';

const { hero } = siteConfig;
---

<section class="hero" id="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="split split--5-7 hero__split">
      <div class="hero__copy">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 id="hero-heading" class="hero__heading">
          {hero.heading}
        </h1>
        <p class="hero__standfirst">{hero.standfirst}</p>

        <div class="btn-row hero__actions">
          <a class="btn" href={hero.primaryCta.href}>
            {hero.primaryCta.label}
          </a>
          <a class="btn btn--ghost" href={hero.secondaryCta.href}>
            {hero.secondaryCta.label}
          </a>
        </div>

        <dl class="hero__register">
          {hero.register.map((row) => (
            <div class="hero__register-row">
              <dt class="mono">{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="plate hero__plate">
        <div class="plate__frame hero__frame">
          <Image
            src={heroImage}
            alt={hero.plate.alt}
            widths={[480, 720, 960, 1280, 1600]}
            sizes="(max-width: 1023px) 92vw, 55vw"
            loading="eager"
            fetchpriority="high"
          />
          <span class="hero__frame-index mono" aria-hidden="true">
            Ref. 01
          </span>
        </div>
        <figcaption>{hero.plate.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(40px, 6vw, 88px));
    padding-bottom: clamp(48px, 6vw, 96px);
  }

  .hero__heading {
    margin-top: 20px;
    max-width: 13ch;
  }

  .hero__standfirst {
    margin-top: 24px;
    max-width: 46ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-2);
  }

  .hero__actions {
    margin-top: 32px;
  }

  .hero__register {
    margin-top: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--rule);
  }

  .hero__register-row {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }

  .hero__register-row dt {
    margin: 0;
    padding-top: 2px;
  }

  .hero__register-row dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-1);
  }

  .hero__frame {
    aspect-ratio: 4 / 3;
  }

  .hero__frame-index {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 3px 6px;
    background: var(--paper);
    color: var(--text-2);
    font-size: 9px;
    letter-spacing: 0.12em;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  @media (max-width: 1023px) {
    .hero__heading {
      max-width: 16ch;
    }
  }

  @media (max-width: 560px) {
    .hero__register-row {
      grid-template-columns: 84px minmax(0, 1fr);
    }
  }
</style>
