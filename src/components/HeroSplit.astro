---
---

<section class="hero-section" id="hero" aria-labelledby="hero-heading">
  <div class="container hero-container">
    <div class="hero-header">
      <span class="section-index">01 / ARCHITECTURAL INFRASTRUCTURE</span>
      <h1 id="hero-heading" class="hero-title">
        Installed LED Displays for Architecture & Property
      </h1>
      <p class="hero-subtext">
        Turnkey digital infrastructure for South African residential estates and commercial precincts. Engineered for daylight legibility, municipal compliance, and seamless daily operation.
      </p>

      <div class="hero-actions">
        <a href="#inquiry" class="btn btn-dark hero-primary-btn">
          <span>Book On-Site Assessment</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#featured-project" class="hero-secondary-link">
          <span>View Flagship Project</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </a>
      </div>
    </div>

    <!-- Full-Bleed Architectural Visual Frame -->
    <div class="hero-dusk-visual">
      <img 
        src="/assets/hero-amphitheater-estate.jpg" 
        alt="Architectural outdoor LED display screen integrated into estate amphitheater wall with live broadcast"
        width="1600"
        height="1066"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="hero-dusk-image"
      />
      <div class="visual-caption-bar">
        <span class="caption-location">George, Western Cape</span>
        <span class="caption-spec">P4.8 Outdoor LED Wall · 6,500 Nits · Synchronised Amphitheater Audio</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: clamp(3.5rem, 6vw, 5.5rem);
    padding-bottom: clamp(4rem, 7vw, 6.5rem);
    background-color: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-border-hairline);
  }

  .hero-header {
    max-width: 960px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-title {
    font-size: var(--font-size-display);
    line-height: var(--line-height-display);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--color-text-primary);
    margin-bottom: 1.25rem;
  }

  .hero-subtext {
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    line-height: 1.5;
    color: var(--color-text-secondary);
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .hero-primary-btn {
    padding: 0.875rem 2rem;
    font-size: 1rem;
  }

  .hero-secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .hero-secondary-link:hover {
    color: var(--color-text-secondary);
    text-decoration: underline;
  }

  .hero-dusk-visual {
    width: 100%;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-bg-obsidian);
    border: 1px solid var(--color-border-hairline);
  }

  .hero-dusk-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .visual-caption-bar {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1.25rem;
    background-color: var(--color-bg-primary);
    border-top: 1px solid var(--color-border-hairline);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  @media (min-width: 640px) {
    .visual-caption-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .caption-location {
    font-weight: 600;
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .caption-spec {
    color: var(--color-text-muted);
  }
</style>
