---
import { siteConfig } from '../config/site';
import InquiryForm from './InquiryForm.astro';
import AdvertisingForm from './AdvertisingForm.astro';

const { commission, contact, coverage } = siteConfig;
---

<section
  class="section section--stone commission"
  id="commission"
  aria-labelledby="commission-heading"
>
  <div class="container">
    <div class="split split--4-8 commission__split">
      <div class="commission__aside sticky-host">
        <div class="sticky">
          <p class="section__index">
            <span>{commission.index}</span>
            <span>{commission.eyebrow}</span>
          </p>
          <h2 id="commission-heading">{commission.heading}</h2>
          <p class="commission__lede">{commission.lede}</p>

          <dl class="register commission__contact">
            <div class="register__row">
              <dt class="register__label">Telephone</dt>
              <dd class="register__value">
                <a class="link" href={`tel:${contact.phoneDial}`}>
                  {contact.phoneDisplay}
                </a>
              </dd>
            </div>
            <div class="register__row">
              <dt class="register__label">WhatsApp</dt>
              <dd class="register__value">
                <a
                  class="link"
                  href={`https://wa.me/${contact.whatsappNumber}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {contact.whatsappDisplay}
                </a>
              </dd>
            </div>
            <div class="register__row">
              <dt class="register__label">Email</dt>
              <dd class="register__value">
                <a class="link" href={`mailto:${contact.emailQuote}`}>
                  {contact.emailQuote}
                </a>
              </dd>
            </div>
            <div class="register__row">
              <dt class="register__label">Hours</dt>
              <dd class="register__value">{contact.operatingHours}</dd>
            </div>
            <div class="register__row">
              <dt class="register__label">Hub</dt>
              <dd class="register__value">{coverage.primaryHub}</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="commission__form">
        <div class="tabs">
          <div class="tabs__list" role="tablist" aria-label="Enquiry type">
            <button
              class="tabs__tab"
              id="tab-survey"
              role="tab"
              type="button"
              aria-selected="true"
              aria-controls="panel-survey"
              tabindex="0"
            >
              <span class="tabs__tab-label">I manage a property</span>
              <span class="tabs__tab-note">A surveyed specification and a fixed quote.</span>
            </button>
            <button
              class="tabs__tab"
              id="tab-advertising"
              role="tab"
              type="button"
              aria-selected="false"
              aria-controls="panel-advertising"
              tabindex="-1"
            >
              <span class="tabs__tab-label">I want to advertise</span>
              <span class="tabs__tab-note">Slots on an installed estate or precinct screen.</span>
            </button>
          </div>

          <div
            class="tabs__panel"
            id="panel-survey"
            role="tabpanel"
            aria-labelledby="tab-survey"
            tabindex="0"
          >
            <InquiryForm />
          </div>

          <div
            class="tabs__panel"
            id="panel-advertising"
            role="tabpanel"
            aria-labelledby="tab-advertising"
            tabindex="0"
            hidden
          >
            <AdvertisingForm />
          </div>
        </div>

        <p class="commission__response small">{commission.responseNote}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .commission__split {
    border-top: 1px solid var(--ink);
    padding-top: clamp(28px, 3vw, 40px);
  }

  .commission__lede {
    margin-top: 18px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 40ch;
  }

  .commission__contact {
    margin-top: 26px;
  }

  .commission__response {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }

  /*
     Two doors rather than two tabs. The buyer names themselves before they see
     a field, which is the whole reason the fork exists: a managing agent and an
     advertiser are not filling in the same form.
  */
  .tabs__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .tabs__tab {
    display: grid;
    align-content: start;
    gap: 4px;
    min-height: 44px;
    padding: 15px 18px 14px;
    border-right: 1px solid var(--rule);
    border-bottom: 2px solid transparent;
    text-align: left;
    color: var(--text-2);
    transition:
      color var(--fast) var(--ease),
      background var(--fast) var(--ease),
      border-color var(--fast) var(--ease);
  }

  .tabs__tab:last-child {
    border-right: 0;
  }

  .tabs__tab:hover {
    color: var(--ink);
    background: var(--paper);
  }

  .tabs__tab[aria-selected='true'] {
    color: var(--ink);
    background: var(--paper);
    border-bottom-color: var(--accent);
  }

  .tabs__tab-label {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .tabs__tab-note {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-3);
  }

  .tabs__panel {
    padding-top: 24px;
  }

  .tabs__panel:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  @media (max-width: 1023px) {
    .commission__lede {
      max-width: 60ch;
    }
  }
</style>

<script>
  const tablist = document.querySelector<HTMLElement>('.tabs__list');
  if (tablist) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !selected;
      });
      if (focus) tabs[index]?.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index, false));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const next =
          event.key === 'ArrowRight'
            ? (index + 1) % tabs.length
            : (index - 1 + tabs.length) % tabs.length;
        select(next);
      });
    });
  }
</script>
