---
import { siteConfig } from '../config/site';

// Same rule as the masthead: on the advertiser page the primary action is
// availability, not a survey, and the bar has to anchor to a section that exists.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onAdvertise = path.startsWith('/advertise');
const target = onAdvertise ? '#availability' : '/#commission';
const label = onAdvertise ? 'Check availability' : 'Commission a survey';
---

<div class="sticky-cta" data-sticky-cta>
  <a class="sticky-cta__btn" href={`tel:${siteConfig.contact.phoneDial}`}>
    <span class="sticky-cta__label">Call</span>
    <span class="sticky-cta__meta numeric">044 801 9000</span>
  </a>
  <a class="sticky-cta__btn sticky-cta__btn--primary" href={target}>
    <span class="sticky-cta__label">{label}</span>
  </a>
</div>

<style>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 90;
    display: none;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 1px;
    background: var(--rule);
    border-top: 1px solid var(--ink);
    padding-bottom: env(safe-area-inset-bottom, 0);
    transition:
      transform var(--normal) var(--ease),
      opacity var(--normal) var(--ease);
  }

  .sticky-cta[data-hidden='true'] {
    transform: translateY(120%);
    opacity: 0;
    pointer-events: none;
  }

  .sticky-cta__btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 56px;
    padding: 8px 16px;
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
  }

  .sticky-cta__btn--primary {
    background: var(--ink);
    color: var(--paper);
    align-items: center;
  }

  .sticky-cta__label {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .sticky-cta__meta {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--text-3);
  }

  @media (max-width: 767px) {
    .sticky-cta {
      display: grid;
    }

    body:has(.sticky-cta) {
      padding-bottom: 57px;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const commission = document.querySelector('#commission, #availability');
  const footer = document.querySelector('footer');

  if (bar && 'IntersectionObserver' in window) {
    // Track every region that already offers its own call to action, so the bar
    // stops covering the form and the footer's own button.
    const covering = new Set<Element>();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) covering.add(entry.target);
          else covering.delete(entry.target);
        }
        bar.dataset.hidden = String(covering.size > 0);
      },
      { rootMargin: '0px 0px -15% 0px' },
    );

    if (commission) observer.observe(commission);
    if (footer) observer.observe(footer);
  }
</script>
