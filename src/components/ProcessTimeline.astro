---
const steps = [
  {
    num: "01",
    title: "Feasibility Assessment",
    desc: "Physical on-site survey evaluating sightline geometry, midday solar lux, mounting substrate capacity, and 220–240V power circuit proximity."
  },
  {
    num: "02",
    title: "Engineering Scope & Board Quote",
    desc: "Scaled structural mounting diagrams, SANS 10160 wind loading calculations, and an itemised proposal structured for STSMA PMR 29(2) or landlord sign-off."
  },
  {
    num: "03",
    title: "Turnkey Installation & CoC",
    desc: "Certified structural steel mounting, concealed weather-sealed cabling, dedicated breaker integration, and SANS 10142-1 Electrical CoC certification."
  },
  {
    num: "04",
    title: "CMS Setup & Operator Handover",
    desc: "Cloud 4G media scheduler configuration, pre-formatted notice templates, 1-on-1 staff training, and contracted maintenance SLA handover."
  }
];
---

<section class="section section--stone hairline-t hairline-b" id="process" aria-labelledby="process-heading">
  <div class="container">
    <div class="process-header">
      <span class="section-index">05 / PROCESS</span>
      <h2 id="process-heading" class="section-title">
        The 4-Stage Delivery Methodology
      </h2>
    </div>

    <!-- Minimalist Connected Engineering Timeline -->
    <div class="process-numbered-grid">
      {steps.map((step) => (
        <div class="process-step-item">
          <div class="timeline-marker" aria-hidden="true">
            <span class="timeline-node"></span>
            <span class="timeline-accent-bar"></span>
          </div>
          <div class="process-num-row">
            <span class="process-num tabular-num">{step.num}</span>
          </div>
          <h3 class="process-step-title">{step.title}</h3>
          <p class="process-step-desc">{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-header {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .process-numbered-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    border-top: 1px solid var(--color-border-hairline);
    padding-top: 1.5rem;
    position: relative;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .process-numbered-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .process-numbered-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem;
    }
  }

  .process-step-item {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: 0.25rem;
  }

  /* Connected Engineering Timeline Marker */
  .timeline-marker {
    position: absolute;
    top: calc(-1.5rem - 1px);
    left: 0;
    width: 100%;
    height: 0;
    pointer-events: none;
  }

  .timeline-node {
    position: absolute;
    top: -4px;
    left: 0;
    width: 8px;
    height: 8px;
    background-color: var(--color-text-primary);
    border-radius: 1px;
    box-shadow: 0 0 0 2px var(--color-bg-stone);
    z-index: 2;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .timeline-accent-bar {
    position: absolute;
    top: -1px;
    left: 0;
    width: 48px;
    height: 2px;
    background-color: var(--color-text-primary);
    z-index: 1;
  }

  .process-step-item:hover .timeline-node {
    transform: scale(1.25);
    background-color: #0284C7;
  }

  .process-num-row {
    margin-bottom: 1rem;
    margin-top: 0.25rem;
  }

  .process-num {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .process-step-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .process-step-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 32ch;
  }
</style>
