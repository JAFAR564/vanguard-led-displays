---
const stages = [
  {
    step: "01",
    title: "On-Site Feasibility Assessment",
    badge: "Step 01 · Site Discovery",
    desc: "A consultative physical or virtual site walkthrough to measure viewing distances, driver/pedestrian sightlines, ambient solar lux levels, mounting wall or pylon structural capacity, and power circuit proximity.",
    deliverables: ["Sightline & pixel pitch determination", "Power feed & circuit review", "Mounting substrate assessment"]
  },
  {
    step: "02",
    title: "Engineering Scope & Board-Ready Quote",
    badge: "Step 02 · Governance Pack",
    desc: "We generate a comprehensive, itemised written proposal. Includes structural drawings, SANS 10160 wind-load calculations, electrical schematic planning, and municipal outdoor advertising by-law compliance notes.",
    deliverables: ["Line-by-line itemised costings", "STSMA PMR 29(2) compliance pack", "Structural & electrical specifications"]
  },
  {
    step: "03",
    title: "Turnkey Installation & Commissioning",
    badge: "Step 03 · Safe Execution",
    desc: "Our installation technicians manage structural steel bracket mounting, cabinet integration, weather-sealed cabling, dedicated breaker wiring, and SANS 10142-1 Certificate of Compliance (CoC) certification.",
    deliverables: ["Certified structural mounting", "SANS 10142-1 Electrical CoC", "Pixel calibration & lux-sensor tuning"]
  },
  {
    step: "04",
    title: "Content Setup, Training & Handover",
    badge: "Step 04 · Operational Ownership",
    desc: "We install and configure the cloud CMS, set up initial notice and promotional templates, and provide practical 1-on-1 operator training so estate staff or marketing teams can update screens effortlessly from any phone or browser.",
    deliverables: ["Cloud / 4G CMS configured", "Staff operator training", "Maintenance & SLA handover"]
  }
];
---

<section class="section" id="process" aria-labelledby="process-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">Proven 4-Stage Methodology</span>
      <h2 id="process-heading" class="section-title">
        How the Project Works: From Site Assessment to Handover
      </h2>
      <p class="section-desc">
        We eliminate contractor fragmentation by managing every milestone from initial site engineering to final operator handover. You receive a predictable, board-ready installation process.
      </p>
    </div>

    <!-- Timeline Grid -->
    <div class="grid-12 timeline-grid">
      {stages.map((stage) => (
        <div class="timeline-step">
          <div class="timeline-step__header">
            <span class="timeline-step__num tabular-num">{stage.step}</span>
            <span class="badge timeline-badge">{stage.badge}</span>
          </div>
          <h3 class="timeline-step__title">{stage.title}</h3>
          <p class="timeline-step__desc">{stage.desc}</p>

          <div class="timeline-deliverables">
            <span class="deliverables-heading">Key Deliverables</span>
            <ul class="deliverables-list">
              {stage.deliverables.map((item) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2463B8" stroke-width="2.5" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline-grid {
    gap: 1.5rem;
  }

  .timeline-step {
    grid-column: span 12;
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-subtle);
    position: relative;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .timeline-step {
      grid-column: span 6;
    }
  }

  @media (min-width: 1024px) {
    .timeline-step {
      grid-column: span 3;
    }
  }

  .timeline-step__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .timeline-step__num {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    color: var(--color-brand-primary);
  }

  .timeline-badge {
    font-size: 0.75rem;
  }

  .timeline-step__title {
    font-size: 1.125rem;
    line-height: 1.35;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .timeline-step__desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .timeline-deliverables {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .deliverables-heading {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .deliverables-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .deliverables-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .deliverables-list svg {
    flex-shrink: 0;
  }
</style>
