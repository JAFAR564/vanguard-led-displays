---
---

<section class="section section--stone hairline-t" id="inquiry" aria-labelledby="inquiry-heading">
  <!-- Hidden anchor targets for backward compatibility with existing links -->
  <div id="quote-form" style="position: absolute; top: -80px;"></div>
  <div id="advertise" style="position: absolute; top: -80px;"></div>

  <div class="container inquiry-container">
    <div class="inquiry-header">
      <span class="section-index">08 / INQUIRY</span>
      <h2 id="inquiry-heading" class="section-title">
        Direct Project & Media Consultation
      </h2>
    </div>

    <!-- Segmented Control Mode Switcher -->
    <div class="segmented-control" role="tablist" aria-label="Inquiry Type">
      <button 
        type="button" 
        id="tab-assessment" 
        class="segmented-btn segmented-btn--active" 
        role="tab" 
        aria-selected="true" 
        aria-controls="panel-assessment"
      >
        Request Site Assessment
      </button>
      <button 
        type="button" 
        id="tab-advertise" 
        class="segmented-btn" 
        role="tab" 
        aria-selected="false" 
        aria-controls="panel-advertise"
      >
        Advertise on Network
      </button>
    </div>

    <!-- FORM PANEL 1: Streamlined 4-Field Site Assessment -->
    <div id="panel-assessment" class="inquiry-panel" role="tabpanel" aria-labelledby="tab-assessment">
      <form id="installation-quote-form" method="POST" action="/api/enquiry" class="minimal-form" novalidate>
        <!-- Honeypot -->
        <div style="display:none !important;" aria-hidden="true">
          <input type="text" id="company_website_url" name="company_website_url" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="formType" value="installation_quote" />
          <input type="hidden" name="buyerRole" value="Property Decision-Maker" />
          <input type="hidden" name="environment" value="Consultation Match" />
          <input type="hidden" id="formRenderTimestamp" name="formRenderTimestamp" value="" />
        </div>

        <div class="form-row form-row--2col">
          <!-- 1. Full Name -->
          <div class="field-group">
            <label for="fullName">Your Name <span class="required-star">*</span></label>
            <input type="text" id="fullName" name="fullName" autocomplete="name" placeholder="Johan van der Merwe" required />
            <span class="field-error" id="fullNameError" aria-live="polite"></span>
          </div>

          <!-- 2. Property & Location -->
          <div class="field-group">
            <label for="propertyName">Property & Location <span class="required-star">*</span></label>
            <input type="text" id="propertyName" name="propertyName" autocomplete="organization" placeholder="e.g. Kingswood Estate, George" required />
            <input type="hidden" id="townCity" name="townCity" value="South Africa" />
            <span class="field-error" id="propertyNameError" aria-live="polite"></span>
          </div>
        </div>

        <!-- 3. Property Category -->
        <div class="field-group">
          <label for="propertyType">Property Category <span class="required-star">*</span></label>
          <select id="propertyType" name="propertyType" required>
            <option value="Residential Estate / HOA">Residential Estate / HOA</option>
            <option value="Body Corporate / Sectional Title">Body Corporate / Sectional Title</option>
            <option value="Shopping Centre / Mall">Shopping Centre / Retail Mall</option>
            <option value="Commercial Precinct / Mixed-Use">Commercial Precinct / Mixed-Use</option>
          </select>
        </div>

        <!-- 4. Phone & Email (2-Column Row) -->
        <div class="form-row form-row--2col">
          <div class="field-group">
            <label for="phone">Phone / WhatsApp Number <span class="required-star">*</span></label>
            <input type="tel" id="phone" name="phone" inputmode="tel" autocomplete="tel" placeholder="082 782 4346" required />
            <span class="field-error" id="phoneError" aria-live="polite"></span>
          </div>

          <div class="field-group">
            <label for="email">Work Email <span class="required-star">*</span></label>
            <input type="email" id="email" name="email" inputmode="email" autocomplete="email" placeholder="manager@property.co.za" required />
            <span class="field-error" id="emailError" aria-live="polite"></span>
          </div>
        </div>

        <!-- Optional Single-Line Note -->
        <div class="field-group">
          <label for="projectNotes">Specific Dimensions or Site Notes (Optional)</label>
          <input type="text" id="projectNotes" name="projectNotes" placeholder="e.g. Main entrance boom, viewing distance ~8m" />
        </div>

        <!-- POPIA Disclosure -->
        <p class="minimal-popia-note">
          Details are processed strictly to prepare your requested feasibility proposal under POPIA Act 4. We never distribute contact details.
        </p>

        <!-- Graceful Error Banner -->
        <div id="form-error-banner" class="form-error-banner" hidden role="alert">
          <p id="form-error-message">Unable to submit online. You can still reach us directly:</p>
          <div class="fallback-cta-row">
            <a id="whatsapp-fallback-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
              Send via WhatsApp
            </a>
            <a id="email-fallback-btn" href="#" class="btn btn-outline btn-sm">
              Send via Email
            </a>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="form-submit-row">
          <button type="submit" id="submit-quote-btn" class="btn btn-dark form-submit-btn">
            <span>Book On-Site Assessment</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </form>

      <!-- In-Place Success Panel -->
      <div id="quote-success-panel" class="minimal-success-panel" hidden aria-live="polite">
        <div class="success-dot" aria-hidden="true">✓</div>
        <h3>Feasibility Request Received</h3>
        <p>Our engineering team will review your property details for <strong id="success-prop-name">your property</strong> and contact you within 1 business day to confirm sightlines and site-visit timing.</p>
      </div>
    </div>

    <!-- FORM PANEL 2: Streamlined 4-Field Media Inquiries -->
    <div id="panel-advertise" class="inquiry-panel" role="tabpanel" aria-labelledby="tab-advertise" hidden>
      <form id="advertising-enquiry-form" method="POST" action="/api/enquiry" class="minimal-form" novalidate>
        <!-- Honeypot -->
        <div style="display:none !important;" aria-hidden="true">
          <input type="text" name="company_website_url" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="formType" value="advertising_enquiry" />
        </div>

        <div class="form-row form-row--2col">
          <!-- 1. Contact Name -->
          <div class="field-group">
            <label for="advName">Contact Name <span class="required-star">*</span></label>
            <input type="text" id="advName" name="advName" autocomplete="name" placeholder="Sarah Smit" required />
            <span class="field-error" id="advNameError" aria-live="polite"></span>
          </div>

          <!-- 2. Brand Name -->
          <div class="field-group">
            <label for="advCompany">Business or Brand Name <span class="required-star">*</span></label>
            <input type="text" id="advCompany" name="advCompany" autocomplete="organization" placeholder="e.g. Outeniqua Media" required />
            <span class="field-error" id="advCompanyError" aria-live="polite"></span>
          </div>
        </div>

        <!-- 3. Phone & Email (2-Column Row) -->
        <div class="form-row form-row--2col">
          <div class="field-group">
            <label for="advPhone">Phone Number <span class="required-star">*</span></label>
            <input type="tel" id="advPhone" name="advPhone" inputmode="tel" autocomplete="tel" placeholder="082 123 4567" required />
            <span class="field-error" id="advPhoneError" aria-live="polite"></span>
          </div>

          <div class="field-group">
            <label for="advEmail">Work Email <span class="required-star">*</span></label>
            <input type="email" id="advEmail" name="advEmail" inputmode="email" autocomplete="email" placeholder="sarah@brand.co.za" required />
            <span class="field-error" id="advEmailError" aria-live="polite"></span>
          </div>
        </div>

        <!-- 4. Campaign Notes -->
        <div class="field-group">
          <label for="advNotes">Target Region or Campaign Requirements (Optional)</label>
          <input type="text" id="advNotes" name="advNotes" placeholder="e.g. Q1 rate card for George / Garden Route estate screens" />
        </div>

        <p class="minimal-popia-note">
          Advertising content is subject to estate HOA and municipal approval. Political and unverified financial promotions are prohibited.
        </p>

        <div class="form-submit-row">
          <button type="submit" id="submit-adv-btn" class="btn btn-dark form-submit-btn">
            Request Media Kit & Rate Card
          </button>
        </div>
      </form>

      <!-- In-Place Success Panel -->
      <div id="adv-success-panel" class="minimal-success-panel" hidden aria-live="polite">
        <div class="success-dot" aria-hidden="true">✓</div>
        <h3>Media Request Received</h3>
        <p>Current screen locations, audience metrics, and rate cards will be dispatched to your email within 1 business day.</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Set render timestamp for speed trap
  const tsField = document.getElementById('formRenderTimestamp') as HTMLInputElement | null;
  if (tsField) tsField.value = String(Date.now());

  // Segmented Control Toggle
  const tabAssessment = document.getElementById('tab-assessment');
  const tabAdvertise = document.getElementById('tab-advertise');
  const panelAssessment = document.getElementById('panel-assessment');
  const panelAdvertise = document.getElementById('panel-advertise');

  tabAssessment?.addEventListener('click', () => {
    tabAssessment.classList.add('segmented-btn--active');
    tabAssessment.setAttribute('aria-selected', 'true');
    tabAdvertise?.classList.remove('segmented-btn--active');
    tabAdvertise?.setAttribute('aria-selected', 'false');
    if (panelAssessment) panelAssessment.hidden = false;
    if (panelAdvertise) panelAdvertise.hidden = true;
  });

  tabAdvertise?.addEventListener('click', () => {
    tabAdvertise.classList.add('segmented-btn--active');
    tabAdvertise.setAttribute('aria-selected', 'true');
    tabAssessment?.classList.remove('segmented-btn--active');
    tabAssessment?.setAttribute('aria-selected', 'false');
    if (panelAdvertise) panelAdvertise.hidden = false;
    if (panelAssessment) panelAssessment.hidden = true;
  });

  // Handle URL hash jumping directly to advertise
  if (window.location.hash === '#advertise') {
    tabAdvertise?.click();
  }

  // Primary Assessment Form Handling
  const quoteForm = document.getElementById('installation-quote-form') as HTMLFormElement | null;
  const quoteSuccess = document.getElementById('quote-success-panel');
  const quotePropEl = document.getElementById('success-prop-name');
  const quoteBtn = document.getElementById('submit-quote-btn') as HTMLButtonElement | null;
  const errorBanner = document.getElementById('form-error-banner');
  const whatsappFallbackBtn = document.getElementById('whatsapp-fallback-btn') as HTMLAnchorElement | null;
  const emailFallbackBtn = document.getElementById('email-fallback-btn') as HTMLAnchorElement | null;

  quoteForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    quoteForm.querySelectorAll('.field-error').forEach(el => (el.textContent = ''));
    if (errorBanner) errorBanner.hidden = true;

    const formData = new FormData(quoteForm);
    const fullName = (formData.get('fullName') as string || '').trim();
    const propertyName = (formData.get('propertyName') as string || '').trim();
    const phone = (formData.get('phone') as string || '').trim();
    const email = (formData.get('email') as string || '').trim();
    const propertyType = (formData.get('propertyType') as string || '').trim();
    const projectNotes = (formData.get('projectNotes') as string || '').trim();

    // Auto-derive town from propertyName if provided
    const townCityInput = document.getElementById('townCity') as HTMLInputElement | null;
    if (townCityInput && propertyName.includes(',')) {
      townCityInput.value = propertyName.split(',').pop()?.trim() || 'Western Cape';
    }

    let hasError = false;
    if (!fullName) {
      setFieldError('fullName', 'Please enter your name.');
      hasError = true;
    }
    if (!propertyName) {
      setFieldError('propertyName', 'Please enter the property name and city.');
      hasError = true;
    }

    let cleanedPhone = phone.replace(/[\s\-\(\)\.]/g, '');
    if (cleanedPhone.startsWith('0027')) cleanedPhone = '+27' + cleanedPhone.slice(4);
    if (cleanedPhone.startsWith('+270')) cleanedPhone = '+27' + cleanedPhone.slice(4);
    else if (cleanedPhone.startsWith('270')) cleanedPhone = '+27' + cleanedPhone.slice(3);

    const saPhoneRegex = /^(?:\+27|27|0)[1-8][0-9]{8}$/;
    if (!cleanedPhone || !saPhoneRegex.test(cleanedPhone)) {
      setFieldError('phone', 'Please enter a valid South African phone number (e.g. 082 782 4346).');
      hasError = true;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!email || !emailRegex.test(email)) {
      setFieldError('email', 'Please enter a valid work email.');
      hasError = true;
    }

    if (hasError) return;

    if (quoteBtn) {
      quoteBtn.disabled = true;
      quoteBtn.textContent = 'Submitting Request...';
    }

    try {
      const res = await fetch('/api/enquiry', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();
      if (res.ok && data.success) {
        quoteForm.hidden = true;
        if (quoteSuccess) {
          quoteSuccess.hidden = false;
          if (quotePropEl) quotePropEl.textContent = propertyName;
          quoteSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } else {
        throw new Error(data.error || 'Server error');
      }
    } catch (err) {
      if (errorBanner) {
        errorBanner.hidden = false;
        const msg = encodeURIComponent(`Hi, I would like to request an LED display assessment for ${propertyName} (${propertyType}). Name: ${fullName}, Phone: ${phone}, Email: ${email}. Notes: ${projectNotes}`);
        if (whatsappFallbackBtn) whatsappFallbackBtn.href = `https://wa.me/27827824346?text=${msg}`;
        if (emailFallbackBtn) emailFallbackBtn.href = `mailto:quotes@leddisplays.co.za?subject=LED%20Assessment%20Request&body=${msg}`;
      }
    } finally {
      if (quoteBtn) {
        quoteBtn.disabled = false;
        quoteBtn.innerHTML = '<span>Book On-Site Assessment</span>';
      }
    }
  });

  // Advertising Form Handling
  const advForm = document.getElementById('advertising-enquiry-form') as HTMLFormElement | null;
  const advSuccess = document.getElementById('adv-success-panel');
  const advBtn = document.getElementById('submit-adv-btn') as HTMLButtonElement | null;

  advForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    advForm.querySelectorAll('.field-error').forEach(el => (el.textContent = ''));

    const formData = new FormData(advForm);
    const name = (formData.get('advName') as string || '').trim();
    const company = (formData.get('advCompany') as string || '').trim();
    const phone = (formData.get('advPhone') as string || '').trim();
    const email = (formData.get('advEmail') as string || '').trim();

    let hasError = false;
    if (!name) {
      setFieldError('advName', 'Please provide your name.');
      hasError = true;
    }
    if (!company) {
      setFieldError('advCompany', 'Please provide your company or brand name.');
      hasError = true;
    }

    let cleanedPhone = phone.replace(/[\s\-\(\)\.]/g, '');
    if (cleanedPhone.startsWith('0027')) cleanedPhone = '+27' + cleanedPhone.slice(4);
    if (cleanedPhone.startsWith('+270')) cleanedPhone = '+27' + cleanedPhone.slice(4);
    else if (cleanedPhone.startsWith('270')) cleanedPhone = '+27' + cleanedPhone.slice(3);

    const saPhoneRegex = /^(?:\+27|27|0)[1-8][0-9]{8}$/;
    if (!cleanedPhone || !saPhoneRegex.test(cleanedPhone)) {
      setFieldError('advPhone', 'Please enter a valid South African phone number.');
      hasError = true;
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!email || !emailRegex.test(email)) {
      setFieldError('advEmail', 'Please enter a valid work email.');
      hasError = true;
    }

    if (hasError) return;

    if (advBtn) {
      advBtn.disabled = true;
      advBtn.textContent = 'Sending Request...';
    }

    try {
      const res = await fetch('/api/enquiry', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();
      if (res.ok && data.success) {
        advForm.hidden = true;
        if (advSuccess) {
          advSuccess.hidden = false;
          advSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } else {
        alert('Submission error. Please reach out to ' + 'advertise@leddisplays.co.za');
      }
    } catch (err) {
      alert('Connection issue. Please email us directly at ' + 'advertise@leddisplays.co.za');
    } finally {
      if (advBtn) {
        advBtn.disabled = false;
        advBtn.textContent = 'Request Media Kit & Rate Card';
      }
    }
  });

  function setFieldError(id: string, msg: string) {
    const el = document.getElementById(`${id}Error`);
    const input = document.getElementById(id);
    if (el) el.textContent = msg;
    if (input) input.setAttribute('aria-invalid', 'true');
  }
</script>

<style>
  .inquiry-container {
    max-width: 780px;
  }

  .inquiry-header {
    margin-bottom: 2.5rem;
  }

  .segmented-control {
    display: flex;
    background-color: var(--color-bg-primary);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-pill);
    padding: 4px;
    margin-bottom: 2.5rem;
    gap: 4px;
  }

  .segmented-btn {
    flex: 1;
    min-height: 44px;
    background: none;
    border: none;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .segmented-btn--active {
    background-color: var(--color-bg-obsidian);
    color: #FFFFFF;
    font-weight: 600;
  }

  @media (max-width: 639px) {
    .segmented-control {
      flex-direction: column;
      border-radius: var(--radius-md);
      padding: 6px;
      gap: 6px;
    }

    .segmented-btn {
      width: 100%;
      text-align: center;
      border-radius: var(--radius-sm);
      padding: 0.625rem 1rem;
      font-size: 0.875rem;
    }
  }

  .minimal-form {
    display: flex;
    flex-direction: column;
  }

  .form-row--2col {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .form-row--2col {
      grid-template-columns: 1fr 1fr;
    }
  }

  .required-star {
    color: var(--color-error);
  }

  .minimal-popia-note {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    margin-block: 1rem 1.75rem;
  }

  .form-submit-row {
    display: flex;
  }

  .form-submit-btn {
    width: 100%;
    padding: 0.875rem 2rem;
    font-size: 1rem;
  }

  @media (min-width: 640px) {
    .form-submit-btn {
      width: auto;
    }
  }

  .form-error-banner {
    padding: 1rem;
    background-color: var(--color-error-bg);
    border: 1px solid var(--color-error-border);
    border-radius: var(--radius-md);
    color: var(--color-error);
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .fallback-cta-row {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .btn-sm {
    min-height: 38px;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .minimal-success-panel {
    text-align: center;
    padding: 3rem 1.5rem;
    background-color: var(--color-bg-primary);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-hairline);
  }

  .success-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background-color: var(--color-success-bg);
    color: var(--color-success);
    font-size: 1.25rem;
    font-weight: 700;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
  }

  .minimal-success-panel h3 {
    font-size: 1.25rem;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .minimal-success-panel p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    max-width: 48ch;
    margin-inline: auto;
    line-height: 1.6;
  }
</style>
