---
import { siteConfig } from '../config/site';
---

<section class="section section--stone hairline-t" id="inquiry" aria-labelledby="inquiry-heading">
  <!-- Hidden anchor targets for backward compatibility with existing links -->
  <div id="quote-form" style="position: absolute; top: -80px;"></div>
  <div id="advertise" style="position: absolute; top: -80px;"></div>

  <div class="container">
    <!-- Section Header -->
    <div class="inquiry-header-block">
      <div class="inquiry-header-meta">
        <span class="section-index">08 / COMMISSIONING & INQUIRY</span>
        <h2 id="inquiry-heading" class="section-title">
          Commission an Architectural LED Monolith
        </h2>
      </div>
      <p class="inquiry-header-sub">
        Direct turnkey accountability from George regional hub. We engineer, mount, wire, certify, and maintain commercial and residential estate displays nationwide.
      </p>
    </div>

    <!-- Segmented Mode Control -->
    <div class="segmented-control" role="tablist" aria-label="Inquiry Category">
      <button 
        type="button" 
        id="tab-assessment" 
        class="segmented-btn segmented-btn--active" 
        role="tab" 
        aria-selected="true" 
        aria-controls="panel-assessment"
      >
        <span class="tab-diode" aria-hidden="true"></span>
        <span>01 / Technical Site Assessment & Quote</span>
      </button>
      <button 
        type="button" 
        id="tab-advertise" 
        class="segmented-btn" 
        role="tab" 
        aria-selected="false" 
        aria-controls="panel-advertise"
      >
        <span>02 / Network Media Kit & Advertising</span>
      </button>
    </div>

    <!-- Split Cockpit Layout -->
    <div class="inquiry-cockpit-grid">
      
      <!-- LEFT: The Interactive Agile Commissioning Form -->
      <div class="inquiry-main-stage">
        
        <!-- PANEL 1: Technical Site Assessment -->
        <div id="panel-assessment" class="inquiry-panel" role="tabpanel" aria-labelledby="tab-assessment">
          <form id="installation-quote-form" method="POST" action="/api/enquiry" class="agile-form" novalidate>
            <!-- Honeypot & Hidden Metadata -->
            <div style="display:none !important;" aria-hidden="true">
              <input type="text" id="company_website_url" name="company_website_url" tabindex="-1" autocomplete="off" />
              <input type="hidden" name="formType" value="installation_quote" />
              <input type="hidden" name="buyerRole" value="Property Decision-Maker" />
              <input type="hidden" name="environment" id="environmentInput" value="Outdoor Gatehouse Monolith" />
              <input type="hidden" id="formRenderTimestamp" name="formRenderTimestamp" value="" />
              <input type="hidden" id="townCity" name="townCity" value="Western Cape" />
              <input type="hidden" id="propertyType" name="propertyType" value="Residential Estate / HOA" />
            </div>

            <!-- Agile Step A: Property Category Selector Tiles -->
            <div class="selector-field-block">
              <label class="selector-label">
                <span class="step-num">A</span>
                <span>Select Property Topology</span>
              </label>

              <div class="property-tiles-grid" role="radiogroup" aria-label="Property Topology">
                <button 
                  type="button" 
                  class="property-tile is-selected" 
                  data-prop-val="Residential Estate / HOA"
                  data-spec-pitch="P2.8 – P3.9 mm"
                  data-spec-nits="6,500 – 10,000 Nits (Auto-Lux)"
                  data-spec-env="Outdoor IP65 Gatehouse Monolith"
                  data-spec-gov="STSMA PMR 29(2) Low-Impact Improvement"
                  role="radio"
                  aria-checked="true"
                >
                  <div class="tile-header">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="tile-icon" aria-hidden="true">
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                      <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span class="tile-badge">RECOMMENDED</span>
                  </div>
                  <span class="tile-title">Residential Estate / HOA</span>
                  <span class="tile-desc">Gatehouse entrance booms, community noticeboard, dark-sky auto-dimming.</span>
                </button>

                <button 
                  type="button" 
                  class="property-tile" 
                  data-prop-val="Body Corporate / Sectional Title"
                  data-spec-pitch="P1.8 – P2.5 mm"
                  data-spec-nits="1,000 – 1,500 Nits (Matte COB)"
                  data-spec-env="Covered Reception / Foyer Wall"
                  data-spec-gov="Sectional Titles Scheme Act 8 / Trustee Sign-Off"
                  role="radio"
                  aria-checked="false"
                >
                  <div class="tile-header">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="tile-icon" aria-hidden="true">
                      <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                      <line x1="9" y1="22" x2="9" y2="2"></line>
                      <line x1="15" y1="22" x2="15" y2="2"></line>
                    </svg>
                  </div>
                  <span class="tile-title">Body Corporate / Foyer</span>
                  <span class="tile-desc">High-density Micro-COB video wall for entrance lobbies and corporate boardrooms.</span>
                </button>

                <button 
                  type="button" 
                  class="property-tile" 
                  data-prop-val="Shopping Centre / Mall"
                  data-spec-pitch="P2.5 – P3.2 mm"
                  data-spec-nits="1,500 – 4,500 Nits (High-Ambient)"
                  data-spec-env="Central Atrium / Food Court"
                  data-spec-gov="Commercial GLA Advertising & Wayfinding"
                  role="radio"
                  aria-checked="false"
                >
                  <div class="tile-header">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="tile-icon" aria-hidden="true">
                      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                      <line x1="3" y1="6" x2="21" y2="6"></line>
                      <path d="M16 10a4 4 0 0 1-8 0"></path>
                    </svg>
                  </div>
                  <span class="tile-title">Shopping Mall / Retail</span>
                  <span class="tile-desc">High-ambient atrium video wall driving non-GLA tenant advertising revenue.</span>
                </button>

                <button 
                  type="button" 
                  class="property-tile" 
                  data-prop-val="Commercial Precinct / Mixed-Use"
                  data-spec-pitch="P3.9 – P6.0 mm"
                  data-spec-nits="8,000 – 10,000 Nits (Direct Sun)"
                  data-spec-env="Roadside DOOH Monolith"
                  data-spec-gov="SANS 10160 Wind & Municipal By-Law Certified"
                  role="radio"
                  aria-checked="false"
                >
                  <div class="tile-header">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="tile-icon" aria-hidden="true">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                  </div>
                  <span class="tile-title">DOOH Monolith Signage</span>
                  <span class="tile-desc">High-impact roadside advertising display with hurricane-rated structural steel.</span>
                </button>
              </div>
            </div>

            <!-- Agile Step B: Turnkey Scope Selection -->
            <div class="selector-field-block">
              <label class="selector-label">
                <span class="step-num">B</span>
                <span>Procurement & Delivery Model</span>
              </label>

              <div class="scope-chips-row" role="radiogroup" aria-label="Procurement Model">
                <button type="button" class="scope-chip is-selected" data-scope="Full Turnkey + SANS CoC" role="radio" aria-checked="true">
                  <span class="chip-dot" aria-hidden="true"></span>
                  <span>Full Turnkey + Civil/Steel + SANS CoC</span>
                </button>
                <button type="button" class="scope-chip" data-scope="Hardware & Cloud CMS Only" role="radio" aria-checked="false">
                  <span class="chip-dot" aria-hidden="true"></span>
                  <span>Hardware & Cloud CMS Supply Only</span>
                </button>
                <button type="button" class="scope-chip" data-scope="Revenue Share / Media Sponsor" role="radio" aria-checked="false">
                  <span class="chip-dot" aria-hidden="true"></span>
                  <span>Managed Media Revenue Share</span>
                </button>
              </div>
            </div>

            <!-- Agile Step C: Contact & Site Specifics -->
            <div class="selector-field-block">
              <label class="selector-label">
                <span class="step-num">C</span>
                <span>Site Details & Direct Contact</span>
              </label>

              <div class="form-grid-2col">
                <!-- Full Name -->
                <div class="field-item">
                  <label for="fullName" class="field-label">Your Full Name <span class="req">*</span></label>
                  <input 
                    type="text" 
                    id="fullName" 
                    name="fullName" 
                    class="field-input" 
                    autocomplete="name" 
                    placeholder="e.g. Johan van der Merwe" 
                    required 
                  />
                  <span class="field-error-msg" id="fullNameError" aria-live="polite"></span>
                </div>

                <!-- Property Name & Town -->
                <div class="field-item">
                  <label for="propertyName" class="field-label">Property Name & Location <span class="req">*</span></label>
                  <input 
                    type="text" 
                    id="propertyName" 
                    name="propertyName" 
                    class="field-input" 
                    autocomplete="organization" 
                    placeholder="e.g. Fancourt Estate, George" 
                    required 
                  />
                  <span class="field-error-msg" id="propertyNameError" aria-live="polite"></span>
                </div>

                <!-- Phone -->
                <div class="field-item">
                  <label for="phone" class="field-label">Mobile / WhatsApp Number <span class="req">*</span></label>
                  <input 
                    type="tel" 
                    id="phone" 
                    name="phone" 
                    class="field-input" 
                    inputmode="tel" 
                    autocomplete="tel" 
                    placeholder="082 123 4567" 
                    required 
                  />
                  <span class="field-error-msg" id="phoneError" aria-live="polite"></span>
                </div>

                <!-- Email -->
                <div class="field-item">
                  <label for="email" class="field-label">Work Email <span class="req">*</span></label>
                  <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    class="field-input" 
                    inputmode="email" 
                    autocomplete="email" 
                    placeholder="manager@estate.co.za" 
                    required 
                  />
                  <span class="field-error-msg" id="emailError" aria-live="polite"></span>
                </div>
              </div>

              <!-- Site Dimensions / Specific Notes -->
              <div class="field-item field-item--full">
                <label for="projectNotes" class="field-label">Approximate Sightlines, Dimensions, or Power Notes (Optional)</label>
                <input 
                  type="text" 
                  id="projectNotes" 
                  name="projectNotes" 
                  class="field-input" 
                  placeholder="e.g. Dual-lane entrance boom, viewing distance 6–12m, existing 220V power DB available" 
                />
              </div>
            </div>

            <!-- POPIA Guarantee -->
            <div class="popia-strip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="popia-icon" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>POPIA Act 4 Encrypted: Details are processed exclusively to compile your feasibility specification. Zero third-party distribution.</span>
            </div>

            <!-- Error Banner -->
            <div id="form-error-banner" class="form-error-banner" hidden role="alert">
              <p id="form-error-message">Unable to submit online. You can still reach our regional engineering office directly:</p>
              <div class="fallback-cta-row">
                <a id="whatsapp-fallback-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
                  Dispatch via WhatsApp
                </a>
                <a id="email-fallback-btn" href="#" class="btn btn-outline btn-sm">
                  Send Direct Email
                </a>
              </div>
            </div>

            <!-- Submit Action Bar -->
            <div class="submit-action-bar">
              <button type="submit" id="submit-quote-btn" class="btn submit-feasibility-btn">
                <span>Request Feasibility Assessment & Sightline Survey</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>
          </form>

          <!-- In-Place Success Celebration Terminal -->
          <div id="quote-success-panel" class="success-terminal-card" hidden aria-live="polite">
            <div class="success-badge">
              <span class="success-check">✓</span>
              <span>COMMISSIONING BRIEF GENERATED</span>
            </div>
            <h3 class="success-heading">Feasibility Survey Request Received</h3>
            <p class="success-desc">
              Your engineering brief for <strong id="success-prop-name">your property</strong> has been logged with our regional engineering dispatch team. A Senior Systems Engineer will review your site sightlines and schedule your on-site physical survey.
            </p>

            <div class="success-spec-receipt">
              <div class="receipt-row">
                <span class="receipt-label">Commissioning ID</span>
                <span class="receipt-val mono-val" id="receipt-id">VGD-GEORGE-9021</span>
              </div>
              <div class="receipt-row">
                <span class="receipt-label">Assigned Hub</span>
                <span class="receipt-val">George Regional Hub (Western Cape)</span>
              </div>
              <div class="receipt-row">
                <span class="receipt-label">Response SLA</span>
                <span class="receipt-val">Within 1 Business Day (On-Site in 48h)</span>
              </div>
            </div>

            <div class="success-actions">
              <a 
                id="success-wa-dispatch" 
                href={`https://wa.me/${siteConfig.contact.whatsappNumber}?text=Hi%2C%20I%20just%20submitted%20a%20site%20feasibility%20request%20for%20an%20architectural%20LED%20display.`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn btn-wa-direct"
              >
                <span>Instant WhatsApp Handoff</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- PANEL 2: Media Kit & Advertising -->
        <div id="panel-advertise" class="inquiry-panel" role="tabpanel" aria-labelledby="tab-advertise" hidden>
          <form id="advertising-enquiry-form" method="POST" action="/api/enquiry" class="agile-form" novalidate>
            <!-- Honeypot -->
            <div style="display:none !important;" aria-hidden="true">
              <input type="text" name="company_website_url" tabindex="-1" autocomplete="off" />
              <input type="hidden" name="formType" value="advertising_enquiry" />
            </div>

            <div class="selector-field-block">
              <label class="selector-label">
                <span class="step-num">01</span>
                <span>Brand & Contact Credentials</span>
              </label>

              <div class="form-grid-2col">
                <div class="field-item">
                  <label for="advName" class="field-label">Contact Name <span class="req">*</span></label>
                  <input type="text" id="advName" name="advName" class="field-input" autocomplete="name" placeholder="Sarah Smit" required />
                  <span class="field-error-msg" id="advNameError" aria-live="polite"></span>
                </div>

                <div class="field-item">
                  <label for="advCompany" class="field-label">Business or Brand Name <span class="req">*</span></label>
                  <input type="text" id="advCompany" name="advCompany" class="field-input" autocomplete="organization" placeholder="e.g. Outeniqua Wealth Management" required />
                  <span class="field-error-msg" id="advCompanyError" aria-live="polite"></span>
                </div>

                <div class="field-item">
                  <label for="advPhone" class="field-label">Phone Number <span class="req">*</span></label>
                  <input type="tel" id="advPhone" name="advPhone" class="field-input" inputmode="tel" autocomplete="tel" placeholder="082 123 4567" required />
                  <span class="field-error-msg" id="advPhoneError" aria-live="polite"></span>
                </div>

                <div class="field-item">
                  <label for="advEmail" class="field-label">Work Email <span class="req">*</span></label>
                  <input type="email" id="advEmail" name="advEmail" class="field-input" inputmode="email" autocomplete="email" placeholder="sarah@brand.co.za" required />
                  <span class="field-error-msg" id="advEmailError" aria-live="polite"></span>
                </div>
              </div>

              <div class="field-item field-item--full">
                <label for="advNotes" class="field-label">Target Audience or Regional Campaign Preferences (Optional)</label>
                <input type="text" id="advNotes" name="advNotes" class="field-input" placeholder="e.g. Q1 rate card for Garden Route golf estates & gatehouse screens" />
              </div>
            </div>

            <p class="popia-strip">
              Advertising spots are strictly vetted for HOA brand alignment. Unverified financial or political campaigns are prohibited.
            </p>

            <div class="submit-action-bar">
              <button type="submit" id="submit-adv-btn" class="btn submit-feasibility-btn">
                <span>Request Media Kit & Rate Card</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </button>
            </div>
          </form>

          <!-- In-Place Media Success Panel -->
          <div id="adv-success-panel" class="success-terminal-card" hidden aria-live="polite">
            <div class="success-badge">
              <span class="success-check">✓</span>
              <span>MEDIA KIT DISPATCH IN PROGRESS</span>
            </div>
            <h3 class="success-heading">Rate Card Request Received</h3>
            <p class="success-desc">
              Current screen footprint, footfall analytics, and seasonal rate cards are being dispatched to your provided work email.
            </p>
          </div>
        </div>

      </div>

      <!-- RIGHT: The Live Engineering Specification HUD & Regional Concierge -->
      <aside class="inquiry-telemetry-sidebar" aria-label="Real-Time Specification HUD">
        
        <!-- Live Computed Spec Card -->
        <div class="spec-terminal-card">
          <div class="terminal-top-bar">
            <div class="terminal-status">
              <span class="terminal-diode"></span>
              <span class="terminal-status-text">LIVE FEASIBILITY TELEMETRY</span>
            </div>
            <span class="terminal-ver">REV 2026.4</span>
          </div>

          <div class="spec-metrics-list">
            <div class="spec-metric-item">
              <span class="spec-metric-k">Recommended Pitch</span>
              <span class="spec-metric-v" id="hud-pitch">P2.8 – P3.9 mm</span>
              <span class="spec-metric-sub" id="hud-pitch-sub">Optimized for 4m–20m approach sightlines</span>
            </div>

            <div class="spec-metric-item">
              <span class="spec-metric-k">Luminance & Contrast</span>
              <span class="spec-metric-v" id="hud-nits">6,500 – 10,000 Nits</span>
              <span class="spec-metric-sub" id="hud-nits-sub">Automatic ambient sensor dimming</span>
            </div>

            <div class="spec-metric-item">
              <span class="spec-metric-k">Chassis Architecture</span>
              <span class="spec-metric-v" id="hud-chassis">Die-Cast Thermal Aluminium</span>
              <span class="spec-metric-sub" id="hud-chassis-sub">IP65 Hermetic Ingress · Passive Convection</span>
            </div>

            <div class="spec-metric-item">
              <span class="spec-metric-k">Governance Standard</span>
              <span class="spec-metric-v" id="hud-gov">STSMA PMR 29(2)</span>
              <span class="spec-metric-sub" id="hud-gov-sub">Classified as essential utility improvement</span>
            </div>
          </div>

          <div class="terminal-footer">
            <div class="terminal-stat-chip">
              <span class="stat-dot"></span>
              <span>SANS 10160 Wind Certified</span>
            </div>
            <div class="terminal-stat-chip">
              <span class="stat-dot"></span>
              <span>SANS 10142-1 CoC Included</span>
            </div>
          </div>
        </div>

        <!-- Regional Concierge Hotline Card -->
        <div class="concierge-card">
          <div class="concierge-header">
            <span class="concierge-badge">REGIONAL SLA HOTLINE</span>
            <span class="concierge-geo">GEORGE · WESTERN CAPE</span>
          </div>

          <p class="concierge-body">
            Direct access to Vanguard technical engineering specialists. Physical site surveys conducted within 48h across the Garden Route.
          </p>

          <div class="concierge-actions">
            <a href={`tel:${siteConfig.contact.phoneDial}`} class="btn-concierge-call">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>{siteConfig.contact.phoneDisplay}</span>
            </a>

            <a 
              href={`https://wa.me/${siteConfig.contact.whatsappNumber}?text=Hi%2C%20I%20would%20like%20to%20enquire%20about%20an%20architectural%20LED%20display%20feasibility%20survey.`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-concierge-wa"
            >
              <span class="wa-indicator"></span>
              <span>WhatsApp Engineering Desk</span>
            </a>
          </div>
        </div>

      </aside>

    </div>
  </div>
</section>

<style>
  /* ==========================================================================
     AGILE ARCHITECTURAL COMMISSIONING TERMINAL
     ========================================================================== */

  .inquiry-header-block {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 820px;
  }

  .inquiry-header-sub {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* --- Segmented Mode Control --- */
  .segmented-control {
    display: inline-flex;
    background-color: rgba(20, 26, 35, 0.05);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-pill);
    padding: 4px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    gap: 4px;
    max-width: 600px;
    width: 100%;
  }

  .segmented-btn {
    flex: 1;
    min-height: 44px;
    background: none;
    border: none;
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tab-diode {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent-cyan);
    opacity: 0.4;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .segmented-btn--active {
    background-color: var(--color-bg-obsidian);
    color: #FFFFFF;
    font-weight: 600;
    box-shadow: 0 4px 12px rgba(11, 15, 23, 0.2);
  }

  .segmented-btn--active .tab-diode {
    opacity: 1;
    transform: scale(1.2);
    box-shadow: 0 0 6px var(--color-accent-cyan);
  }

  @media (max-width: 640px) {
    .segmented-control {
      flex-direction: column;
      border-radius: var(--radius-md);
      padding: 6px;
    }
    .segmented-btn {
      width: 100%;
      border-radius: var(--radius-sm);
    }
  }

  /* --- Cockpit 2-Column Split --- */
  .inquiry-cockpit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
