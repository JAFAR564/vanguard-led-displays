---
import { siteConfig } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top split split--5-7">
      <div class="footer__identity">
        <p class="footer__wordmark">{siteConfig.brand.shortName}</p>
        <p class="footer__tagline">
          {siteConfig.brand.tagline}. Surveyed, engineered and certified from George, Western Cape.
        </p>
        <a class="btn footer__cta" href="/#commission">
          Commission a survey
        </a>
      </div>

      <div class="footer__grid">
        {siteConfig.footer.columns.map((column) => (
          <nav class="footer__col" aria-label={column.title}>
            <h2 class="footer__col-title">{column.title}</h2>
            <ul role="list">
              {column.links.map((link) => (
                <li>
                  <a class="footer__link" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}

        <div class="footer__col">
          <h2 class="footer__col-title">Contact</h2>
          <ul role="list">
            <li>
              <a class="footer__link" href={`tel:${siteConfig.contact.phoneDial}`}>
                {siteConfig.contact.phoneDisplay}
              </a>
            </li>
            <li>
              <a
                class="footer__link"
                href={`https://wa.me/${siteConfig.contact.whatsappNumber}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                WhatsApp {siteConfig.contact.whatsappDisplay}
              </a>
            </li>
            <li>
              <a class="footer__link" href={`mailto:${siteConfig.contact.emailQuote}`}>
                {siteConfig.contact.emailQuote}
              </a>
            </li>
            <li>
              <a class="footer__link" href={`mailto:${siteConfig.contact.emailAdvertise}`}>
                {siteConfig.contact.emailAdvertise}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer__legal">
      <p class="mono footer__legal-line">{siteConfig.footer.legal.join(' · ')}</p>
      <div class="footer__legal-actions">
        <button class="footer__legal-btn" type="button" data-open-privacy>
          Privacy notice
        </button>
        <span class="mono" aria-hidden="true">
          ·
        </span>
        <a class="footer__legal-btn" href={`mailto:${siteConfig.contact.emailQuote}`}>
          Information officer
        </a>
        <span class="mono footer__year">© {year}</span>
      </div>
    </div>
  </div>

  <dialog class="privacy" id="privacy-dialog" aria-labelledby="privacy-title" data-privacy-dialog>
    <div class="privacy__inner">
      <!-- Sticky, because on a phone the only close control used to be at the end
           of the scroll. The bar carries the title and a 44px dismiss. -->
      <div class="privacy__bar">
        <div class="privacy__bar-text">
          <p class="mono privacy__eyebrow">POPIA · Act 4 of 2013</p>
          <h2 id="privacy-title" class="privacy__title">
            {siteConfig.footer.privacy.title}
          </h2>
        </div>
        <form method="dialog" class="privacy__dismiss">
          <button class="privacy__close" type="submit" aria-label="Close privacy notice">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.2"></path>
            </svg>
          </button>
        </form>
      </div>

      <div class="privacy__content">
        <div class="privacy__body">
          {siteConfig.footer.privacy.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <p class="privacy__contact">
            <strong>{siteConfig.contact.informationOfficer}</strong>
            <br />
            <a class="link" href={`mailto:${siteConfig.contact.emailQuote}`}>
              {siteConfig.contact.emailQuote}
            </a>
            <br />
            {siteConfig.brand.headquarters}
          </p>
        </div>
        <form method="dialog" class="privacy__actions">
          <button class="btn" type="submit">
            Close
          </button>
        </form>
      </div>
    </div>
  </dialog>
</footer>

<style>
  .footer {
    background: var(--paper);
    border-top: 1px solid var(--ink);
    padding-block: clamp(48px, 6vw, 80px) 28px;
  }

  .footer__top {
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .footer__wordmark {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .footer__tagline {
    margin-top: 16px;
    max-width: 34ch;
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  .footer__cta {
    margin-top: 24px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .footer__col-title {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    padding-bottom: 10px;
    margin-bottom: 6px;
    border-bottom: 1px solid var(--rule);
  }

  .footer__col ul {
    display: grid;
    gap: 2px;
    margin: 0;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;
    /* 44px, like every other tappable row on the site. The two columns are the
       most-tapped small targets on a phone and were the only ones still at 36. */
    min-height: 44px;
    font-size: 0.875rem;
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--fast) var(--ease);
  }

  .footer__link:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .footer__legal-line {
    margin: 0;
    letter-spacing: 0.08em;
  }

  .footer__legal-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  /* One shared box model for the button, the link and the separator spans.
     A taller button beside bare spans is what pushed the baselines apart. */
  .footer__legal-actions > * {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-2);
    text-decoration: none;
    vertical-align: middle;
  }

  .footer__legal-btn {
    border-bottom: 1px solid transparent;
  }

  .footer__legal-btn:hover {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .footer__year {
    margin-left: 4px;
    color: var(--text-3);
  }

  /* Privacy dialog ------------------------------------------------------- */
  .privacy {
    width: min(680px, calc(100vw - 32px));
    max-height: 86vh;
    padding: 0;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-1);
    overflow: hidden;
  }

  .privacy::backdrop {
    background: rgb(11 13 16 / 0.55);
  }

  .privacy__inner {
    overflow-y: auto;
    overscroll-behavior: contain;
    /* The dialog's max-height includes its 1px border; matching 86vh here would
       clip the last two pixels of the scroll area. */
    max-height: calc(86vh - 2px);
  }

  .privacy__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 16px clamp(20px, 4vw, 32px) 14px;
    background: var(--surface);
    border-bottom: 1px solid var(--rule);
  }

  .privacy__bar-text {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .privacy__eyebrow {
    margin: 0;
    font-size: 10px;
    color: var(--text-3);
  }

  .privacy__title {
    font-size: var(--step-2);
    line-height: 1.1;
  }

  .privacy__dismiss {
    flex: 0 0 auto;
    margin: 0;
  }

  .privacy__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-top: -2px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-2);
    transition:
      color var(--fast) var(--ease),
      border-color var(--fast) var(--ease);
  }

  .privacy__close:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .privacy__close svg {
    width: 14px;
    height: 14px;
  }

  .privacy__content {
    padding: clamp(20px, 4vw, 30px) clamp(20px, 4vw, 32px) clamp(22px, 4vw, 32px);
  }

  .privacy__body {
    display: grid;
    gap: 14px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  .privacy__contact {
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
  }

  .privacy__actions {
    margin-top: 24px;
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 767px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
    .footer__legal {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>

<script>
  const openers = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-open-privacy], [data-privacy-open]'),
  );
  const dialog = document.querySelector<HTMLDialogElement>('[data-privacy-dialog]');
  let lastOpener: HTMLButtonElement | null = null;

  if (openers.length > 0 && dialog) {
    openers.forEach((button) => {
      button.addEventListener('click', () => {
        lastOpener = button;
        dialog.showModal();
      });
    });

    dialog.addEventListener('click', (event) => {
      const rect = dialog.getBoundingClientRect();
      const inside =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;
      if (!inside) dialog.close();
    });

    dialog.addEventListener('close', () => lastOpener?.focus());
  }
</script>
