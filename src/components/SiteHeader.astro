---
import { siteConfig } from '../config/site';
---

<header class="site-header" id="top">
  <div class="container site-header__inner">
    <!-- Minimalist Brand Identity -->
    <a href="#top" class="brand-link" aria-label={`${siteConfig.brand.name} - Home`}>
      <span class="brand-dot" aria-hidden="true"></span>
      <span class="brand-text">SA LED <span class="brand-subtext">DISPLAYS</span></span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        <li><a href="#use-cases" class="nav-anchor">Applications</a></li>
        <li><a href="#featured-project" class="nav-anchor">Case Study</a></li>
        <li><a href="#solutions" class="nav-anchor">Comparison</a></li>
        <li><a href="#process" class="nav-anchor">Process</a></li>
        <li><a href="#architecture" class="nav-anchor">Architecture</a></li>
        <li><a href="#faq" class="nav-anchor">FAQ</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="#inquiry" class="btn btn-dark header-pill-btn">
        Book Assessment
      </a>
      <button 
        type="button" 
        class="menu-toggle-btn" 
        aria-expanded="false" 
        aria-controls="mobile-dropdown" 
        aria-label="Toggle navigation menu"
      >
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Minimal Dropdown -->
  <div id="mobile-dropdown" class="mobile-dropdown" hidden>
    <div class="container">
      <ul class="mobile-nav-list">
        <li><a href="#use-cases" class="mobile-anchor">Applications</a></li>
        <li><a href="#featured-project" class="mobile-anchor">Case Study</a></li>
        <li><a href="#solutions" class="mobile-anchor">Comparison</a></li>
        <li><a href="#process" class="mobile-anchor">Process</a></li>
        <li><a href="#architecture" class="mobile-anchor">Architecture</a></li>
        <li><a href="#faq" class="mobile-anchor">FAQ</a></li>
        <li class="mobile-dropdown-cta">
          <a href="#inquiry" class="btn btn-dark btn-full">Book On-Site Assessment</a>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.querySelector('.menu-toggle-btn');
  const dropdown = document.getElementById('mobile-dropdown');

  if (toggleBtn && dropdown) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      dropdown.hidden = isExpanded;
    });

    dropdown.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        dropdown.hidden = true;
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-hairline);
    height: 68px;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .brand-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-text-primary);
    border-radius: var(--radius-pill);
  }

  .brand-text {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
  }

  .brand-subtext {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-text-secondary);
    letter-spacing: 0.06em;
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 960px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }

  .nav-anchor {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-anchor:hover {
    color: var(--color-text-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-pill-btn {
    min-height: 40px;
    padding: 0.5rem 1.25rem;
    font-size: 0.875rem;
  }

  .menu-toggle-btn {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  @media (min-width: 960px) {
    .menu-toggle-btn {
      display: none;
    }
  }

  .menu-line {
    display: block;
    width: 20px;
    height: 1.5px;
    background-color: var(--color-text-primary);
    transition: transform 0.2s ease;
  }

  .mobile-dropdown {
    position: absolute;
    top: 68px;
    left: 0;
    width: 100%;
    background-color: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-border-hairline);
    padding-block: 1rem 1.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-anchor {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.625rem 0.75rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .mobile-anchor:hover {
    color: var(--color-text-secondary);
  }

  .mobile-dropdown-cta {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-hairline);
  }

  .btn-full {
    width: 100%;
  }
</style>
