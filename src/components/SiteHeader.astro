---
import { siteConfig } from '../config/site';
---

<!-- Fixed Floating Capsule Header Container -->
<header class="site-header-fixed" id="site-header" role="banner">
  <div class="header-capsule header-capsule--dark" id="header-capsule">
    
    <!-- Minimalist Brand Identity with Adaptive Vector Logo -->
    <a href="/" class="brand-link" aria-label={`${siteConfig.brand.name} - Home`}>
      <svg class="brand-logo-svg" viewBox="0 0 320 54" fill="none" role="img" aria-hidden="true">
        <!-- Precision Chassis Monogram -->
        <g transform="translate(4, 5)">
          <rect x="0" y="0" width="22" height="44" rx="2" fill="currentColor" class="tile-primary" />
          <rect x="25" y="0" width="18" height="44" rx="2" fill="currentColor" opacity="0.65" class="tile-secondary" />
          <line x1="0" y1="14.6" x2="43" y2="14.6" stroke="currentColor" stroke-opacity="0.22" stroke-width="1" />
          <line x1="0" y1="29.3" x2="43" y2="29.3" stroke="currentColor" stroke-opacity="0.22" stroke-width="1" />
          <circle cx="34" cy="7.5" r="2.5" fill="#38BDF8" class="logo-diode" />
        </g>
        <!-- Architectural Wordmark -->
        <g transform="translate(62, 0)">
          <text x="0" y="27" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Inter', sans-serif" font-size="20" font-weight="700" letter-spacing="3.5" fill="currentColor">VANGUARD</text>
          <text x="0" y="44" font-family="'JetBrains Mono', ui-monospace, SFMono-Regular, monospace" font-size="8.5" font-weight="500" letter-spacing="2.8" class="brand-subtext">ARCHITECTURAL DISPLAYS</text>
        </g>
      </svg>
    </a>

    <!-- Desktop Navigation Links with Pill Hover & Active Spy -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        <li><a href="/#use-cases" class="nav-anchor" data-nav-target="use-cases">Applications</a></li>
        <li><a href="/#featured-project" class="nav-anchor" data-nav-target="featured-project">Case Study</a></li>
        <li><a href="/#solutions" class="nav-anchor" data-nav-target="solutions">Comparison</a></li>
        <li><a href="/#process" class="nav-anchor" data-nav-target="process">Process</a></li>
        <li><a href="/#architecture" class="nav-anchor" data-nav-target="architecture">Architecture</a></li>
        <li><a href="/about" class="nav-anchor" data-nav-target="about">About</a></li>
        <li><a href="/#faq" class="nav-anchor" data-nav-target="faq">FAQ</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Live Regional Hub Diode -->
      <div class="regional-telemetry-badge" title="George Hub Regional SLA Coverage">
        <span class="telemetry-diode-pulse" aria-hidden="true"></span>
        <span class="telemetry-badge-text">GEORGE · WC</span>
      </div>

      <!-- High-Impact Assessment CTA -->
      <a href="/#inquiry" class="btn header-cta-pill">
        <span>Book Survey</span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>

      <!-- Mobile Morphing Hamburger Button -->
      <button 
        type="button" 
        class="menu-toggle-btn" 
        id="menu-toggle" 
        aria-expanded="false" 
        aria-controls="mobile-drawer" 
        aria-label="Toggle navigation menu"
      >
        <span class="menu-bar bar-top" aria-hidden="true"></span>
        <span class="menu-bar bar-bot" aria-hidden="true"></span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Full-Height Architectural Drawer -->
<div class="mobile-drawer-portal" id="mobile-drawer" hidden aria-hidden="true">
  <div class="mobile-drawer-backdrop" id="mobile-backdrop"></div>
  
  <aside class="mobile-drawer-sheet" id="mobile-sheet" role="dialog" aria-modal="true" aria-label="Site Navigation Directory">
    <!-- Drawer Top Telemetry Bar -->
    <div class="drawer-header">
      <div class="drawer-telemetry">
        <span class="telemetry-diode-pulse" aria-hidden="true"></span>
        <span class="drawer-telemetry-text">SYSTEM ACTIVE · GEORGE REGIONAL HUB</span>
      </div>
      <button type="button" class="drawer-close-btn" id="drawer-close" aria-label="Close navigation menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Architectural Numerical Directory -->
    <nav class="drawer-nav" aria-label="Mobile Navigation Links">
      <ul class="drawer-nav-list">
        <li class="drawer-item" style="--idx: 1;">
          <a href="/#use-cases" class="drawer-link">
            <span class="drawer-num">01</span>
            <div class="drawer-link-meta">
              <span class="drawer-title">Applications</span>
              <span class="drawer-sub">Estates & Commercial Atriums</span>
            </div>
          </a>
        </li>
        <li class="drawer-item" style="--idx: 2;">
          <a href="/#featured-project" class="drawer-link">
            <span class="drawer-num">02</span>
            <div class="drawer-link-meta">
              <span class="drawer-title">Case Study</span>
              <span class="drawer-sub">Turnkey Estate Installation</span>
            </div>
          </a>
        </li>
        <li class="drawer-item" style="--idx: 3;">
          <a href="/#solutions" class="drawer-link">
            <span class="drawer-num">03</span>
            <div class="drawer-link-meta">
              <span class="drawer-title">Comparison Matrix</span>
              <span class="drawer-sub">Outdoor DOOH vs Indoor Micro-COB</span>
            </div>
          </a>
        </li>
        <li class="drawer-item" style="--idx: 4;">
          <a href="/#process" class="drawer-link">
            <span class="drawer-num">04</span>
            <div class="drawer-link-meta">
              <span class="drawer-title">Delivery Methodology</span>
              <span class="drawer-sub">SANS 10160 Wind & Electrical CoC</span>
            </div>
          </a>
        </li>
        <li class="drawer-item" style="--idx: 5;">
          <a href="/#architecture" class="drawer-link">
            <span class="drawer-num">05</span>
            <div class="drawer-link-meta">
              <span class="drawer-title">Hardware Architecture</span>
              <span class="drawer-sub">3-Layer Modular Aluminium Chassis</span>
            </div>
          </a>
        </li>
        <li class="drawer-item" style="--idx: 6;">
          <a href="/about" class="drawer-link">
            <span class="drawer-num">06</span>
            <div class="drawer-link-meta">
              <span class="drawer-title">About Vanguard</span>
              <span class="drawer-sub">Engineering Philosophy & Provenance</span>
            </div>
          </a>
        </li>
        <li class="drawer-item" style="--idx: 7;">
          <a href="/#faq" class="drawer-link">
            <span class="drawer-num">07</span>
            <div class="drawer-link-meta">
              <span class="drawer-title">Governance & FAQ</span>
              <span class="drawer-sub">STSMA PMR 29(2) & Municipality</span>
            </div>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Quick Regional Action Strip -->
    <div class="drawer-footer">
      <a href="/#inquiry" class="btn header-cta-pill drawer-primary-cta">
        <span>Book On-Site Technical Survey</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <div class="drawer-contact-chips">
        <a href={`tel:${siteConfig.contact.phoneDial}`} class="contact-chip">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>{siteConfig.contact.phoneDisplay}</span>
        </a>
        <a 
          href={`https://wa.me/${siteConfig.contact.whatsappNumber}?text=Hi%2C%20I%20would%20like%20to%20enquire%20about%20an%20architectural%20LED%20display.`} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="contact-chip contact-chip--wa"
        >
          <span class="wa-dot"></span>
          <span>WhatsApp Specialist</span>
        </a>
      </div>
    </div>
  </aside>
</div>

<style>
  /* ==========================================================================
     FLOATING CAPSULE NAVIGATION SYSTEM
     ========================================================================== */

  .site-header-fixed {
    position: fixed;
    top: clamp(0.75rem, 1.8vw, 1.25rem);
    left: 0;
    right: 0;
    z-index: 100;
    pointer-events: none;
    display: flex;
    justify-content: center;
    padding-inline: 1rem;
  }

  .header-capsule {
    pointer-events: auto;
    width: 100%;
    max-width: 1180px;
    height: 56px;
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.5rem 0 clamp(1rem, 2vw, 1.35rem);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    transition: background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* --- State 1: Smoked Obsidian Glass (Over Dark Hero / Obsidian Sections) --- */
  .header-capsule--dark {
    background-color: rgba(11, 15, 23, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
  }

  .header-capsule--dark .brand-subtext {
    fill: #94A3B8;
  }

  .header-capsule--dark .nav-anchor {
    color: rgba(255, 255, 255, 0.72);
  }

  .header-capsule--dark .nav-anchor:hover {
    color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.08);
  }

  .header-capsule--dark .nav-anchor.is-active {
    color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.14);
  }

  .header-capsule--dark .regional-telemetry-badge {
    background-color: rgba(20, 26, 35, 0.85);
    border-color: rgba(255, 255, 255, 0.12);
    color: #CBD5E1;
  }

  .header-capsule--dark .header-cta-pill {
    background-color: #FFFFFF;
    color: #0B0F17;
    border-color: transparent;
  }

  .header-capsule--dark .header-cta-pill:hover {
    background-color: #E2E8F0;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(255, 255, 255, 0.2);
  }

  .header-capsule--dark .menu-toggle-btn {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
  }

  /* --- State 2: Frosted Alabaster Glass (Over White & Stone Sections) --- */
  .header-capsule--light {
    background-color: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(11, 15, 23, 0.08);
    box-shadow: 0 12px 36px rgba(11, 15, 23, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    color: #0B0F17;
  }

  .header-capsule--light .brand-subtext {
    fill: #64748B;
  }

  .header-capsule--light .nav-anchor {
    color: var(--color-text-secondary);
  }

  .header-capsule--light .nav-anchor:hover {
    color: var(--color-text-primary);
    background-color: rgba(11, 15, 23, 0.05);
  }

  .header-capsule--light .nav-anchor.is-active {
    color: var(--color-text-primary);
    background-color: rgba(11, 15, 23, 0.08);
    font-weight: 600;
  }

  .header-capsule--light .regional-telemetry-badge {
    background-color: rgba(247, 247, 245, 0.85);
    border-color: var(--color-border-hairline);
    color: var(--color-text-secondary);
  }

  .header-capsule--light .header-cta-pill {
    background-color: #0B0F17;
    color: #FFFFFF;
    border-color: transparent;
  }

  .header-capsule--light .header-cta-pill:hover {
    background-color: #1F2937;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(11, 15, 23, 0.25);
  }

  .header-capsule--light .menu-toggle-btn {
    background-color: rgba(11, 15, 23, 0.05);
    border-color: rgba(11, 15, 23, 0.1);
    color: #0B0F17;
  }

  /* --- Brand Link & Adaptive SVG Logo --- */
  .brand-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .brand-logo-svg {
    height: 28px;
    width: auto;
    display: block;
    transition: opacity 0.2s ease;
  }

  .brand-link:hover .brand-logo-svg {
    opacity: 0.9;
  }

  .logo-diode {
    filter: drop-shadow(0 0 4px rgba(56, 189, 248, 0.8));
  }

  /* --- Desktop Nav Links --- */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 960px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .nav-anchor {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0.35rem 0.75rem;
    font-size: 0.84375rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                color 0.2s ease;
    white-space: nowrap;
  }

  /* --- Header Actions --- */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .regional-telemetry-badge {
    display: none;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    user-select: none;
    transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease;
  }

  @media (min-width: 1100px) {
    .regional-telemetry-badge {
      display: inline-flex;
    }
  }

  .telemetry-diode-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent-cyan);
    box-shadow: 0 0 6px var(--color-accent-cyan);
    animation: diodeGlow 2.4s infinite ease-in-out;
  }

  @keyframes diodeGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .header-cta-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 38px;
    padding: 0.45rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: var(--radius-pill);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.4s ease,
                color 0.4s ease,
                box-shadow 0.2s ease;
    white-space: nowrap;
  }

  @media (max-width: 639px) {
    .header-cta-pill {
      display: none;
    }
  }

  /* --- Morphing Hamburger Button --- */
  .menu-toggle-btn {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    border: 1px solid;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.15s ease;
  }

  .menu-toggle-btn:active {
    transform: scale(0.94);
  }

  @media (min-width: 960px) {
    .menu-toggle-btn {
      display: none;
    }
  }

  .menu-bar {
    display: block;
    width: 17px;
    height: 1.5px;
    background-color: currentColor;
    border-radius: 1px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.2s ease;
  }

  .menu-toggle-btn[aria-expanded="true"] .bar-top {
    transform: translateY(3.25px) rotate(45deg);
  }

  .menu-toggle-btn[aria-expanded="true"] .bar-bot {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ==========================================================================
     MOBILE FULL-HEIGHT ARCHITECTURAL DRAWER
     ========================================================================== */

  .mobile-drawer-portal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-drawer-portal.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-drawer-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(11, 15, 23, 0.7);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .mobile-drawer-sheet {
    position: relative;
    width: 100%;
    max-width: 520px;
    height: 100%;
    max-height: 100dvh;
    background-color: var(--color-bg-obsidian);
    border-left: 1px solid var(--color-border-dark);
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem clamp(1.5rem, 4vw, 2.5rem);
    transform: translate3d(0, -30px, 0);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    box-sizing: border-box;
  }

  .mobile-drawer-portal.is-open .mobile-drawer-sheet {
    transform: translate3d(0, 0, 0);
  }

  /* Drawer Header */
  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border-dark);
    margin-bottom: 1.5rem;
  }

  .drawer-telemetry {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-accent-cyan);
  }

  .drawer-close-btn {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-pill);
    color: var(--color-text-on-dark);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .drawer-close-btn:hover {
    background-color: rgba(255, 255, 255, 0.12);
  }

  .drawer-close-btn:active {
    transform: scale(0.94);
  }

  /* Drawer Navigation List */
  .drawer-nav {
    flex: 1 1 auto;
  }

  .drawer-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .drawer-item {
    opacity: 0;
    transform: translate3d(-15px, 0, 0);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.35s ease;
    transition-delay: calc(var(--idx) * 40ms);
  }

  .mobile-drawer-portal.is-open .drawer-item {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .drawer-link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .drawer-link:hover, .drawer-link:focus-visible {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .drawer-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent-cyan);
    letter-spacing: 0.1em;
  }

  .drawer-link-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .drawer-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-on-dark);
    letter-spacing: -0.01em;
  }

  .drawer-sub {
    font-size: 0.75rem;
    color: var(--color-text-muted-dark);
  }

  /* Drawer Footer */
  .drawer-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-dark);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1rem;
  }

  .drawer-primary-cta {
    width: 100%;
    justify-content: center;
    min-height: 48px;
    font-size: 0.9375rem;
    background-color: #FFFFFF;
    color: #0B0F17;
  }

  .drawer-contact-chips {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-pill);
    background-color: rgba(20, 26, 35, 0.75);
    border: 1px solid var(--color-border-dark);
    color: var(--color-text-muted-dark);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .contact-chip:hover {
    color: var(--color-text-on-dark);
    border-color: #475569;
  }

  .contact-chip--wa {
    color: #4ADE80;
    border-color: rgba(74, 222, 128, 0.25);
  }

  .contact-chip--wa:hover {
    border-color: #4ADE80;
  }

  .wa-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #4ADE80;
    box-shadow: 0 0 6px #4ADE80;
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .header-capsule, .drawer-item, .mobile-drawer-sheet, .menu-bar {
      transition: none !important;
      transform: none !important;
    }
    .telemetry-diode-pulse {
      animation: none !important;
    }
  }
</style>

<script>
  (function initArchitecturalNavigation() {
    const capsule = document.getElementById('header-capsule');
    const menuToggle = document.getElementById('menu-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const drawerClose = document.getElementById('drawer-close');
    const backdrop = document.getElementById('mobile-backdrop');
    const navAnchors = document.querySelectorAll<HTMLAnchorElement>('.nav-anchor');
    const drawerLinks = document.querySelectorAll<HTMLAnchorElement>('.drawer-link');

    // 1. Adaptive Header Color Mode (Smoked Obsidian on Dark sections, Frosted Alabaster on Light)
    function updateHeaderTheme() {
      if (!capsule) return;

      // On /about or standalone subpages without scrollytelling hero
      if (window.location.pathname.startsWith('/about')) {
        const footerSec = document.getElementById('footer');
        if (footerSec && footerSec.getBoundingClientRect().top <= 60) {
          capsule.classList.remove('header-capsule--light');
          capsule.classList.add('header-capsule--dark');
        } else {
          capsule.classList.remove('header-capsule--dark');
          capsule.classList.add('header-capsule--light');
        }
        return;
      }

      // Check if header capsule (top ~ 16-70px) is currently positioned over a dark section:
      const headerY = 56;
      let isDarkSection = false;

      // Check 1: Hero area — before Section 2 (#use-cases) reaches the header
      const useCasesSec = document.getElementById('use-cases');
      if (useCasesSec) {
        const uRect = useCasesSec.getBoundingClientRect();
        if (uRect.top > headerY) {
          isDarkSection = true;
        }
      } else {
        const scrollY = window.scrollY || window.pageYOffset;
        if (scrollY < 120) {
          isDarkSection = true;
        }
      }

      // Check 2: Hardware Architecture section (#architecture is obsidian)
      if (!isDarkSection) {
        const archSec = document.getElementById('architecture');
        if (archSec) {
          const aRect = archSec.getBoundingClientRect();
          if (aRect.top <= headerY && aRect.bottom >= 30) {
            isDarkSection = true;
          }
        }
      }

      // Check 3: Site Footer (#footer is obsidian)
      if (!isDarkSection) {
        const footerSec = document.getElementById('footer');
        if (footerSec) {
          const fRect = footerSec.getBoundingClientRect();
          if (fRect.top <= headerY) {
            isDarkSection = true;
          }
        }
      }

      // Apply adaptive theme classes
      if (isDarkSection) {
        capsule.classList.remove('header-capsule--light');
        capsule.classList.add('header-capsule--dark');
      } else {
        capsule.classList.remove('header-capsule--dark');
        capsule.classList.add('header-capsule--light');
      }
    }

    // 2. Active Section Scroll Spy
    const targetSectionIds = ['use-cases', 'featured-project', 'solutions', 'process', 'architecture', 'faq'];
    const sectionElements = targetSectionIds.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];

    function updateActiveNavSpy() {
      if (window.location.pathname.startsWith('/about')) {
        navAnchors.forEach(a => {
          if (a.getAttribute('data-nav-target') === 'about') {
            a.classList.add('is-active');
          } else {
            a.classList.remove('is-active');
          }
        });
        return;
      }

      const scrollPos = window.scrollY + 140;
      let currentSectionId = '';

      for (let i = sectionElements.length - 1; i >= 0; i--) {
        const sec = sectionElements[i];
        if (sec.offsetTop <= scrollPos) {
          currentSectionId = sec.id;
          break;
        }
      }

      navAnchors.forEach(a => {
        const target = a.getAttribute('data-nav-target');
        if (target && target === currentSectionId) {
          a.classList.add('is-active');
        } else {
          a.classList.remove('is-active');
        }
      });
    }

    // Passive scroll listener for smooth real-time tracking
    window.addEventListener('scroll', () => {
      updateHeaderTheme();
      updateActiveNavSpy();
    }, { passive: true });

    // 3. Mobile Drawer Controls
    function openDrawer() {
      if (!drawer || !menuToggle) return;
      drawer.hidden = false;
      drawer.setAttribute('aria-hidden', 'false');
      // Micro-delay to trigger CSS opacity transition
      requestAnimationFrame(() => {
        drawer.classList.add('is-open');
        menuToggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      });
    }

    function closeDrawer() {
      if (!drawer || !menuToggle) return;
      drawer.classList.remove('is-open');
      menuToggle.setAttribute('aria-expanded', 'false');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (!drawer.classList.contains('is-open')) {
          drawer.hidden = true;
        }
      }, 350);
    }

    if (menuToggle) {
      menuToggle.addEventListener('click', () => {
        const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          closeDrawer();
        } else {
          openDrawer();
        }
      });
    }

    if (drawerClose) drawerClose.addEventListener('click', closeDrawer);
    if (backdrop) backdrop.addEventListener('click', closeDrawer);

    // Close drawer when any nav link inside it is tapped
    drawerLinks.forEach(link => {
      link.addEventListener('click', closeDrawer);
    });

    // Keyboard support: Escape closes drawer
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer && !drawer.hidden) {
        closeDrawer();
      }
    });

    // Initial check
    updateHeaderTheme();
    updateActiveNavSpy();
  })();
</script>
