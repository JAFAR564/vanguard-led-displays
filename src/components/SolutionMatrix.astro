---
const comparisonRows = [
  {
    parameter: "Primary Deployment",
    outdoor: "Estate gatehouse booms, monument signage & perimeter approaches",
    indoor: "Retail shopping atriums, central courts & commercial reception halls"
  },
  {
    parameter: "Peak Luminance",
    outdoor: "6,500 – 10,000 nits (Combats direct coastal midday sun with auto-dimming)",
    indoor: "600 – 1,000 nits (Anti-glare matte encapsulation, flicker-free low-blue light)"
  },
  {
    parameter: "Cabinet Architecture",
    outdoor: "Precision die-cast aluminium with fanless convective thermal dissipation",
    indoor: "CNC magnesium/aluminium 16:9 golden ratio chassis for native 2K/4K/8K"
  },
  {
    parameter: "Pixel Density / Sightline",
    outdoor: "P2.5 – P8.0 mm (Optimised for vehicular approach distances 3m–35m)",
    indoor: "P0.9 – P2.5 mm Micro-COB / SMD (Razor-sharp pedestrian inspection 1m–8m)"
  },
  {
    parameter: "Maintenance Access",
    outdoor: "Dual front and rear fast-latch servicing with hermetic IP65 perimeter seals",
    indoor: "100% front vacuum magnetic extraction; zero rear clearance required"
  },
  {
    parameter: "Compliance & Safety",
    outdoor: "SANS 10160 coastal wind-load certification & IP65 weather rating",
    indoor: "SANS 10142-1 certified electrical circuit & ≥ 3,840Hz refresh rate"
  },
  {
    parameter: "Commercial Model",
    outdoor: "Outright CapEx / STSMA PMR 29 Reserve Fund or turnkey media sponsorship",
    indoor: "Direct asset purchase or managed retail advertising revenue share"
  }
];
---

<section class="section" id="solutions" aria-labelledby="solutions-heading">
  <div class="container">
    <div class="comparison-header">
      <span class="section-index">04 / COMPARISON</span>
      <h2 id="solutions-heading" class="section-title">
        Display Solutions & Commercial Delivery
      </h2>
    </div>

    <!-- Desktop Comparison Table (>= 768px) -->
    <div class="table-container">
      <table class="borderless-table" role="table">
        <thead>
          <tr class="table-header-row">
            <th scope="col" class="th-param">Engineering Parameter</th>
            <th scope="col" class="th-col">Outdoor Weatherproof Displays</th>
            <th scope="col" class="th-col">Indoor Commercial Video Walls</th>
          </tr>
        </thead>
        <tbody>
          {comparisonRows.map((row) => (
            <tr class="table-body-row">
              <td class="td-param">{row.parameter}</td>
              <td class="td-value td-outdoor">{row.outdoor}</td>
              <td class="td-value td-indoor">{row.indoor}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile Comparison View (< 768px) -->
    <div class="mobile-matrix-list">
      {comparisonRows.map((row) => (
        <div class="mobile-matrix-card">
          <div class="mobile-matrix-param-tag">{row.parameter}</div>
          
          <div class="mobile-matrix-spec">
            <span class="mobile-spec-badge">Outdoor Weatherproof</span>
            <p class="mobile-spec-desc">{row.outdoor}</p>
          </div>

          <div class="mobile-matrix-spec">
            <span class="mobile-spec-badge mobile-spec-badge--indoor">Indoor Commercial</span>
            <p class="mobile-spec-desc">{row.indoor}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .comparison-header {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .table-container {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .borderless-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 680px;
  }

  /* Mobile Comparison Cards (< 768px) */
  .mobile-matrix-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }

  .mobile-matrix-card {
    padding: 1.5rem;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-sm);
  }

  .mobile-matrix-param-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border-hairline);
  }

  .mobile-matrix-spec {
    margin-bottom: 1rem;
  }

  .mobile-matrix-spec:last-child {
    margin-bottom: 0;
  }

  .mobile-spec-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-primary);
    background-color: var(--color-bg-stone);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.35rem;
  }

  .mobile-spec-badge--indoor {
    color: #1E293B;
    background-color: #E2E8F0;
  }

  .mobile-spec-desc {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-primary);
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .mobile-matrix-list {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .table-container {
      display: none;
    }
  }

  .table-header-row {
    border-bottom: 2px solid var(--color-text-primary);
  }

  .table-header-row th {
    padding: 1rem 1.5rem 1rem 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .th-param {
    width: 25%;
    font-family: var(--font-mono);
    font-size: 0.8125rem !important;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted) !important;
  }

  .th-col {
    width: 37.5%;
  }

  .table-body-row {
    border-bottom: 1px solid var(--color-border-hairline);
    transition: background-color 0.15s ease;
  }

  .table-body-row:hover {
    background-color: var(--color-bg-stone);
  }

  .table-body-row td {
    padding: 1.5rem 1.5rem 1.5rem 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    vertical-align: top;
  }

  .td-param {
    font-family: var(--font-mono);
    font-size: 0.8125rem !important;
    font-weight: 600;
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .td-value {
    color: var(--color-text-secondary);
  }

  .td-outdoor {
    padding-right: 2rem !important;
  }
</style>
