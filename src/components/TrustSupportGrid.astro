---
const layers = [
  {
    layer: "Layer 01",
    title: "Centralised Cloud CMS",
    desc: "A secure web portal enabling property managers to schedule dayparted playlists, instant emergency alerts, and tenant notices in under 90 seconds from any desktop or mobile browser."
  },
  {
    layer: "Layer 02",
    title: "Edge Player & Lux Sensor",
    desc: "Hardened industrial micro-controller with 4G LTE telemetry, onboard solid-state caching for 100% offline failover, and automated real-time ambient lux-sensor dimming."
  },
  {
    layer: "Layer 03",
    title: "Modular Aluminium Chassis",
    desc: "Marine-grade IP65 weather-sealed aluminium cabinet assemblies engineered for Cape coastal salt-fog, passive heat dissipation, and load-shedding electrical surge suppression."
  }
];
---

<section class="section section--obsidian" id="architecture" aria-labelledby="architecture-heading">
  <div class="container">
    <div class="architecture-header">
      <span class="section-index">06 / HARDWARE & SYSTEM ARCHITECTURE</span>
      <h2 id="architecture-heading" class="section-title">
        The 3-Layer Hardware & Control Architecture
      </h2>
    </div>

    <!-- 3-Column Obsidian Hardware Chassis Grid with Staggered Left Fly-In Entrance -->
    <div class="chassis-grid" id="layer-cards-grid">
      {layers.map((layer, idx) => (
        <div class="chassis-card" style={`--card-idx: ${idx};`}>
          <div class="layer-tag-row">
            <span class="layer-dot" aria-hidden="true"></span>
            <span class="layer-tag tabular-num">{layer.layer}</span>
          </div>
          <h3 class="chassis-title">{layer.title}</h3>
          <p class="chassis-desc">{layer.desc}</p>
        </div>
      ))}
    </div>

    <!-- Seamless Architectural Hardware Visual Canvas -->
    <div class="chassis-visual-canvas">
      <div class="chassis-img-wrap">
        <img 
          src="/assets/hardware-exploded-chassis.webp" 
          alt="Exploded isometric engineering CAD visualization of Vanguard modular die-cast aluminium display chassis with Micro-COB matrix and IP65 perimeter seal"
          width="1672"
          height="941"
          loading="lazy"
          decoding="async"
          class="chassis-engineering-img"
        />
      </div>
      <div class="chassis-caption-strip">
        <div class="caption-metric-group">
          <span class="caption-metric-label">CHASSIS BLUEPRINT</span>
          <span class="caption-metric-value">Die-Cast Thermal Aluminium · IP65 Hermetic Ingress · Dual Front/Rear Fast-Latch</span>
        </div>
        <span class="caption-telemetry-tag">100% MODULAR CUSTODY</span>
      </div>
    </div>
  </div>
</section>

<style>
  .architecture-header {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .chassis-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 960px) {
    .chassis-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  .chassis-card {
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, rgba(20, 26, 35, 0.75) 0%, rgba(14, 18, 26, 0.6) 100%);
    border: 1px solid var(--color-border-dark);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: clamp(1.5rem, 2.5vw, 2rem);
    position: relative;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);

    /* Flight Entrance Initial State: Invisible & shifted left */
    opacity: 0;
    transform: translate3d(-70px, 0, 0);
    will-change: transform, opacity;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.25s ease,
                box-shadow 0.25s ease;
  }

  /* When triggered by scroll intersection */
  .chassis-grid.is-visible .chassis-card {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  /* Staggered sequential entry: one after the other */
  .chassis-grid.is-visible .chassis-card:nth-child(1) {
    transition-delay: 0.05s;
  }

  .chassis-grid.is-visible .chassis-card:nth-child(2) {
    transition-delay: 0.20s;
  }

  .chassis-grid.is-visible .chassis-card:nth-child(3) {
    transition-delay: 0.35s;
  }

  /* Interactive tactile hover state */
  @media (hover: hover) and (pointer: fine) {
    .chassis-grid.is-visible .chassis-card:hover {
      border-color: rgba(56, 189, 248, 0.4);
      transform: translate3d(0, -3px, 0);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), 0 0 16px rgba(56, 189, 248, 0.1);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 0.25s ease,
                  box-shadow 0.25s ease;
    }
  }

  /* Reduced motion degradation */
  @media (prefers-reduced-motion: reduce) {
    .chassis-card {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  .layer-tag-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .layer-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-accent-cyan);
    border-radius: var(--radius-pill);
    box-shadow: 0 0 8px var(--color-accent-cyan);
  }

  .layer-tag {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .chassis-title {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-text-on-dark);
    margin-bottom: 0.875rem;
    line-height: 1.3;
  }

  .chassis-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted-dark);
    max-width: 36ch;
  }

  #architecture {
    background-color: #0D0F12;
    background-image: radial-gradient(ellipse 75% 65% at 50% 55%, #141820 0%, #0D0F12 70%);
  }

  /* Seamless Floating 3D Hardware Canvas */
  .chassis-visual-canvas {
    margin-top: clamp(3.5rem, 7vw, 5.5rem);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .chassis-img-wrap {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    /* Softly melt all outer edges into 100% transparency while preserving callout labels */
    mask-image: radial-gradient(ellipse 96% 88% at 50% 50%, black 68%, rgba(0, 0, 0, 0.9) 82%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 96% 88% at 50% 50%, black 68%, rgba(0, 0, 0, 0.9) 82%, transparent 100%);
  }

  .chassis-engineering-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.65));
  }

  /* Architectural Telemetry Capsule Strip */
  .chassis-caption-strip {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0.75rem 1.4rem;
    background: rgba(14, 18, 26, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    margin-top: 1.5rem;
    width: 100%;
    max-width: 860px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 768px) {
    .chassis-caption-strip {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      width: auto;
    }
  }

  .caption-metric-group {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  @media (min-width: 768px) {
    .caption-metric-group {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
    }
  }

  .caption-metric-label {
    font-size: 0.6875rem;
    color: var(--color-accent-cyan);
    letter-spacing: 0.08em;
  }

  .caption-metric-value {
    font-size: 0.75rem;
    color: var(--color-text-muted-dark);
  }

  .caption-telemetry-tag {
    font-size: 0.6875rem;
    color: var(--color-accent-cyan);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
</style>

<script>
  (function initLayerCardsEntrance() {
    const grid = document.getElementById('layer-cards-grid');
    if (!grid) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      grid.classList.add('is-visible');
      return;
    }

    if (!('IntersectionObserver' in window)) {
      grid.classList.add('is-visible');
      return;
    }

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          grid.classList.add('is-visible');
          obs.unobserve(entry.target);
        }
      });
    }, {
      rootMargin: '0px 0px -8% 0px',
      threshold: 0.1
    });

    observer.observe(grid);
  })();
</script>
