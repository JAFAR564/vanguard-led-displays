---
---

<section class="section section--sheet-reveal" id="use-cases" aria-labelledby="use-cases-heading">
  <!-- Architectural Tactile Sheet Handle Affordance -->
  <div class="sheet-handle-bar" aria-hidden="true">
    <div class="sheet-handle-pill"></div>
  </div>

  <div class="container">
    <div class="section-title-wrap">
      <span class="section-index">02 / APPLICATIONS</span>
      <h2 id="use-cases-heading" class="section-title">
        Residential Estates & Commercial Precincts
      </h2>
    </div>

    <!-- Clean 2-Column Editorial Split with Hairline Divider -->
    <div class="editorial-split-grid">
      <!-- Col 1: Estates -->
      <article class="split-column">
        <div class="split-visual-frame">
          <span class="image-category-pill">Residential</span>
          <img 
            src="/assets/estate-golf-installation.jpg" 
            alt="Outdoor architectural LED display screen integrated in landscaped residential estate setting"
            width="800"
            height="532"
            loading="lazy"
            decoding="async"
            class="split-image"
          />
        </div>

        <div class="split-content">
          <h3 class="split-heading">Residential Estates & HOAs</h3>
          <p class="split-desc">
            Gatehouse & precinct communication infrastructure replacing temporary vinyl banners, municipal notices, and static noticeboards.
          </p>

          <ul class="spec-four-word-list" role="list">
            <li>
              <span class="spec-dash" aria-hidden="true">—</span>
              <span class="spec-term">Gatehouse Access & Security</span>
            </li>
            <li>
              <span class="spec-dash" aria-hidden="true">—</span>
              <span class="spec-term">Dark-Sky Nuisance Compliant</span>
            </li>
            <li>
              <span class="spec-dash" aria-hidden="true">—</span>
              <span class="spec-term">STSMA PMR 29(2) Approved</span>
            </li>
          </ul>
        </div>
      </article>

      <!-- Col 2: Commercial -->
      <article class="split-column split-column--bordered">
        <div class="split-visual-frame">
          <span class="image-category-pill">Commercial</span>
          <img 
            src="/assets/commercial-motorsport-display.jpg" 
            alt="Outdoor high-impact commercial LED screen showing live split-screen broadcast and advertising telemetry"
            width="800"
            height="532"
            loading="lazy"
            decoding="async"
            class="split-image"
          />
        </div>

        <div class="split-content">
          <h3 class="split-heading">Commercial & Retail Precincts</h3>
          <p class="split-desc">
            Seamless atrium video walls and external pylon displays driving tenant promotions and non-GLA commercial advertising revenue.
          </p>

          <ul class="spec-four-word-list" role="list">
            <li>
              <span class="spec-dash" aria-hidden="true">—</span>
              <span class="spec-term">Atrium & Façade Presence</span>
            </li>
            <li>
              <span class="spec-dash" aria-hidden="true">—</span>
              <span class="spec-term">3,840Hz Camera-Safe Display</span>
            </li>
            <li>
              <span class="spec-dash" aria-hidden="true">—</span>
              <span class="spec-term">Non-GLA Media Revenue</span>
            </li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .section--sheet-reveal {
    position: relative;
    z-index: 10;
    background-color: var(--color-bg-primary);
    border-top-left-radius: clamp(20px, 3.5vw, 32px);
    border-top-right-radius: clamp(20px, 3.5vw, 32px);
    border-top: 1px solid var(--color-border-hairline);
    box-shadow: 0 -24px 64px rgba(11, 15, 23, 0.35);
    margin-top: -100vh;
    margin-top: -100dvh;
  }

  .sheet-handle-bar {
    display: flex;
    justify-content: center;
    padding-top: 1.25rem;
    padding-bottom: 0.5rem;
  }

  .sheet-handle-pill {
    width: 44px;
    height: 4px;
    border-radius: var(--radius-pill);
    background-color: var(--color-border-hairline);
    transition: background-color 0.2s ease, width 0.2s ease;
  }

  .section--sheet-reveal:hover .sheet-handle-pill {
    background-color: var(--color-text-muted);
    width: 52px;
  }

  .section-title-wrap {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .editorial-split-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 960px) {
    .editorial-split-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }

    .split-column--bordered {
      padding-left: 4rem;
      border-left: 1px solid var(--color-border-hairline);
    }
  }

  .split-column {
    display: flex;
    flex-direction: column;
  }

  .split-visual-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: #F3F4F6;
    margin-bottom: 1.75rem;
    border: 1px solid var(--color-border-hairline);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.10);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .split-visual-frame:hover {
    border-color: #94A3B8;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.15), 0 8px 24px rgba(11, 15, 23, 0.06);
  }

  .image-category-pill {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #0B0F17;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 2px 8px rgba(11, 15, 23, 0.10);
    pointer-events: none;
  }

  .split-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .split-visual-frame:hover .split-image {
    transform: scale(1.02);
  }

  .split-heading {
    font-size: var(--font-size-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .split-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    max-width: 48ch;
  }

  .spec-four-word-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border-hairline);
  }

  .spec-four-word-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .spec-dash {
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .section--sheet-reveal {
      margin-top: 0;
      border-radius: 0;
      box-shadow: none;
    }
    .sheet-handle-bar {
      display: none;
    }
  }
</style>
