---
---

<section class="section section--subtle" id="use-cases" aria-labelledby="use-cases-heading">
  <div class="container">
    <div class="section-header">
      <span class="section-eyebrow">Target Property Environments</span>
      <h2 id="use-cases-heading" class="section-title">
        Built for Residential Estates, Shopping Centres & Commercial Precincts
      </h2>
      <p class="section-desc">
        We understand the stark differences between a quiet residential estate requiring strict governance sign-off and a busy retail mall maximizing commercial footfall. Our solutions are custom-engineered for each operational environment.
      </p>
    </div>

    <div class="grid-12 use-cases-grid">
      <!-- Card A: Residential Estates & HOAs -->
      <article class="card use-case-card">
        <div class="use-case-card__header">
          <span class="badge">Persona 01 & 02</span>
          <h3 class="use-case-card__title">Residential Estates, HOAs & Body Corporates</h3>
          <p class="use-case-card__subtitle">
            Main entrance gatehouses, security booms, clubhouse foyers, and perimeter monument signs.
          </p>
        </div>

        <ul class="use-case-features" role="list">
          <li class="feature-item">
            <span class="feature-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2463B8" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </span>
            <div>
              <strong>Instant Community & Utility Communication</strong>
              <p>Broadcast gatehouse access notices, load-shedding schedules, municipal water maintenance alerts, and AGM dates directly to arriving residents.</p>
            </div>
          </li>

          <li class="feature-item">
            <span class="feature-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2463B8" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <line x1="9" y1="3" x2="9" y2="21"/>
              </svg>
            </span>
            <div>
              <strong>Replaces Cluttered Temporary Banners</strong>
              <p>Permanently eliminates ripped vinyl banners, faded flyers, and unapproved event signs that degrade estate aesthetic value and breach local municipal by-laws.</p>
            </div>
          </li>

          <li class="feature-item">
            <span class="feature-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2463B8" stroke-width="2">
                <circle cx="12" cy="12" r="5"/>
                <line x1="12" y1="1" x2="12" y2="3"/>
                <line x1="12" y1="21" x2="12" y2="23"/>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                <line x1="1" y1="12" x2="3" y2="12"/>
                <line x1="21" y1="12" x2="23" y2="12"/>
              </svg>
            </span>
            <div>
              <strong>Dark-Sky Compliant & Zero Nuisance</strong>
              <p>Integrated lux sensors automatically dim the screen at night, preventing light trespass into adjacent residences and complying with STSMA PMR 29 nuisance provisions.</p>
            </div>
          </li>

          <li class="feature-item">
            <span class="feature-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2463B8" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <path d="M16 13H8"/>
                <path d="M16 17H8"/>
                <path d="M10 9H8"/>
              </svg>
            </span>
            <div>
              <strong>Board-Ready STSMA PMR 29(2) Pack</strong>
              <p>Receive an itemised, element-by-element proposal proving essential community utility, structural wind-load compliance, and clear reserve fund alignment for trustee sign-off.</p>
            </div>
          </li>
        </ul>

        <div class="use-case-card__footer">
          <a href="#quote-form" class="btn btn-secondary btn-full">
            Request Estate Feasibility Survey
          </a>
        </div>
      </article>

      <!-- Card B: Shopping Centres & Commercial Precincts -->
      <article class="card use-case-card">
        <div class="use-case-card__header">
          <span class="badge">Persona 03</span>
          <h3 class="use-case-card__title">Shopping Centres & Commercial Precincts</h3>
          <p class="use-case-card__subtitle">
            High-footfall central atriums, food court plazas, exterior parking pylons, and roadside displays.
          </p>
        </div>

        <ul class="use-case-features" role="list">
          <li class="feature-item">
            <span class="feature-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2463B8" stroke-width="2">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </span>
            <div>
              <strong>Seamless High-Impact Video Walls</strong>
              <p>Bezel-free modular LED panels deliver vivid, bright imagery that competes effortlessly with ambient daylight under glass skylights and illuminated retail store facades.</p>
            </div>
          </li>

          <li class="feature-item">
            <span class="feature-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2463B8" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </span>
            <div>
              <strong>Tenant Promotions & Dayparted Playlists</strong>
              <p>Empower marketing teams to schedule morning, lunch, and evening tenant campaigns, flash sales, and anchor-store promotions with automated proof-of-play logs.</p>
            </div>
          </li>

          <li class="feature-item">
            <span class="feature-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2463B8" stroke-width="2">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
            </span>
            <div>
              <strong>Camera-Safe 3,840Hz+ Refresh Rate</strong>
              <p>High PWM driver ICs eliminate unsightly black scanning bands when shoppers photograph or film your atrium displays for Instagram or TikTok.</p>
            </div>
          </li>

          <li class="feature-item">
            <span class="feature-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2463B8" stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"/>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
              </svg>
            </span>
            <div>
              <strong>Non-GLA Commercial Media Yield</strong>
              <p>Convert inactive architectural walls into revenue-producing digital out-of-home (DOOH) assets. Offset display capital investment through third-party advertising slots.</p>
            </div>
          </li>
        </ul>

        <div class="use-case-card__footer">
          <a href="#quote-form" class="btn btn-primary btn-full">
            Request Commercial Mall Proposal
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .use-cases-grid {
    gap: 2rem;
  }

  .use-case-card {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  @media (min-width: 960px) {
    .use-case-card {
      grid-column: span 6;
    }
  }

  .use-case-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .use-case-card__header {
    margin-bottom: 1.75rem;
  }

  .use-case-card__header .badge {
    margin-bottom: 0.75rem;
  }

  .use-case-card__title {
    font-size: var(--font-size-h3);
    line-height: var(--line-height-h3);
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
  }

  .use-case-card__subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .use-case-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background-color: var(--color-bg-tint);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .feature-item strong {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
    line-height: 1.35;
  }

  .feature-item p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .use-case-card__footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .btn-full {
    width: 100%;
  }
</style>
