---
import { siteConfig } from '../config/site';
const project = siteConfig.featuredProject;
---

<section class="section" id="featured-project" aria-labelledby="featured-heading">
  <div class="container">
    <div class="section-header">
      <div class="project-eyebrow-wrap">
        <span class="badge">Verified Local Flagship</span>
        <span class="location-pill">{project.location}</span>
      </div>
      <h2 id="featured-heading" class="section-title">
        Proven in the Field: Residential Estate Installation in George, Western Cape
      </h2>
      <p class="section-desc">
        Authentic proof of completed local execution. Inspect how our turnkey outdoor display performs under real-world direct South African sunlight at a premier residential estate gateway.
      </p>
    </div>

    <!-- Video Container & Proof Presentation -->
    <div class="video-proof-container">
      <div class="video-player-wrapper">
        <video 
          controls 
          preload="none" 
          playsinline 
          poster={project.videoPoster}
          class="video-element"
          aria-label="Video showcase of completed residential estate LED display in George, Western Cape"
        >
          <source src={project.videoSrc} type="video/mp4" />
          <track kind="captions" srclang="en" label="English" default />
          Your browser does not support the video tag. Please view our still photography below.
        </video>
      </div>

      <!-- Expandable Video Transcript & Technical Overview -->
      <details class="video-transcript-accordion">
        <summary class="video-transcript-summary">
          <span class="summary-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
          </span>
          <span>View Video Transcript & Technical Installation Overview</span>
        </summary>
        <div class="transcript-content">
          <h4>Video Overview & Narration</h4>
          <p>
            <strong>[00:00–00:20] Site Context:</strong> The video opens on the main access boulevard leading to the residential estate gatehouse in George, with the Outeniqua Mountain range in the background. Arriving vehicles approach the security boom lanes where the outdoor LED display is integrated into the stone and slate monument architecture.
          </p>
          <p>
            <strong>[00:21–00:45] Daylight Readability:</strong> Even under midday coastal sunlight exceeding 90,000 lux ambient illumination, the high-luminance LED matrix displays razor-sharp estate notices, road speed limits, and municipal water maintenance schedules without daylight washout or glare.
          </p>
          <p>
            <strong>[00:46–01:10] Mechanical & Electrical Neatness:</strong> The camera moves behind the monument wall, showcasing the clean, concealed cable ducting, SANS 10142-1 certified electrical isolation breaker, IP65 weather-sealed aluminium cabinet joints, and top-mounted ambient lux sensor that automates evening dimming.
          </p>
          <p>
            <strong>[01:11–01:24] Operational Control:</strong> Cut to the estate manager demonstrating the browser-based cloud CMS on a desktop tablet. A new gate notice is scheduled in under 60 seconds and syncs over 4G to the gatehouse display instantly.
          </p>
        </div>
      </details>
    </div>

    <!-- 3 Structured Engineering Proof Cards -->
    <div class="grid-12 proof-cards-grid">
      <div class="card proof-card">
        <div class="proof-card__num tabular-num" aria-hidden="true">01</div>
        <h3 class="proof-card__title">The Property Brief</h3>
        <p class="proof-card__body">{project.brief}</p>
        <div class="proof-card__meta">
          <span class="meta-label">Location</span>
          <span class="meta-value">{project.location}</span>
        </div>
      </div>

      <div class="card proof-card">
        <div class="proof-card__num tabular-num" aria-hidden="true">02</div>
        <h3 class="proof-card__title">Sightline & Mounting Execution</h3>
        <p class="proof-card__body">{project.sightlineExecution}</p>
        <div class="proof-card__meta">
          <span class="meta-label">Engineering</span>
          <span class="meta-value">SANS 10160 Wind & IP65 Corrosion</span>
        </div>
      </div>

      <div class="card proof-card">
        <div class="proof-card__num tabular-num" aria-hidden="true">03</div>
        <h3 class="proof-card__title">Daily Operational Outcome</h3>
        <p class="proof-card__body">{project.outcome}</p>
        <div class="proof-card__meta">
          <span class="meta-label">CMS Control</span>
          <span class="meta-value">Cloud 4G / Wi-Fi with Offline Cache</span>
        </div>
      </div>
    </div>

    <!-- Inline Assessment Prompt -->
    <div class="proof-action-banner">
      <div class="proof-action-text">
        <strong>Interested in upgrading your property entrance or commercial atrium?</strong>
        <p>Book a local site survey in George, the Garden Route, or request a national project feasibility consultation.</p>
      </div>
      <a href="#quote-form" class="btn btn-primary">
        Book On-Site Feasibility Assessment
      </a>
    </div>
  </div>
</section>

<style>
  .project-eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .location-pill {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .video-proof-container {
    margin-bottom: 2.5rem;
  }

  .video-player-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-bg-inverse);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--color-border-subtle);
  }

  .video-element {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .video-transcript-accordion {
    margin-top: 1rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-subtle);
    overflow: hidden;
  }

  .video-transcript-summary {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    cursor: pointer;
    user-select: none;
    min-height: 44px;
  }

  .video-transcript-summary:hover {
    color: var(--color-brand-primary);
  }

  .transcript-content {
    padding: 1.25rem;
    border-top: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-primary);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .transcript-content h4 {
    margin-bottom: 0.75rem;
    color: var(--color-text-primary);
  }

  .transcript-content p {
    margin-bottom: 0.75rem;
  }

  .transcript-content p:last-child {
    margin-bottom: 0;
  }

  .proof-cards-grid {
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .proof-card {
    grid-column: span 12;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  @media (min-width: 960px) {
    .proof-card {
      grid-column: span 4;
    }
  }

  .proof-card__num {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-brand-primary);
    opacity: 0.65;
    margin-bottom: 0.5rem;
  }

  .proof-card__title {
    font-size: 1.125rem;
    line-height: 1.35;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .proof-card__body {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .proof-card__meta {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .meta-value {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .proof-action-banner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    background-color: var(--color-bg-tint);
    border: 1px solid rgba(36, 99, 184, 0.2);
    border-radius: var(--radius-lg);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .proof-action-banner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .proof-action-text strong {
    display: block;
    font-size: 1.0625rem;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .proof-action-text p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }
</style>
