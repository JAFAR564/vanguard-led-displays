---
import { siteConfig } from '../config/site';
const project = siteConfig.featuredProject;
---

<section class="section section--stone hairline-t hairline-b" id="featured-project" aria-labelledby="case-study-heading">
  <div class="container">
    <div class="case-study-header">
      <span class="section-index">03 / CASE STUDY</span>
      <h2 id="case-study-heading" class="section-title">
        Residential Estate Gateway Deployment
      </h2>
    </div>

    <!-- Video Showcase -->
    <div class="case-study-layout">
      <div class="video-container">
        <video 
          controls 
          preload="none" 
          playsinline 
          poster={project.videoPoster}
          class="video-player"
          aria-label="Video documentation of completed outdoor estate LED screen in Western Cape"
        >
          <source src={project.videoSrc} type="video/mp4" />
          <track kind="captions" srclang="en" label="English" default />
          Your browser does not support the video tag.
        </video>
      </div>

      <!-- Standout Editorial Pull-Quote -->
      <div class="editorial-quote-wrap">
        <blockquote class="editorial-pull-quote">
          “The gatehouse display transformed resident communications from cluttered temporary vinyl banners into an instant, unified architectural gateway.”
        </blockquote>
        <div class="quote-attribution">
          <span class="attribution-title">Estate Management Operations</span>
          <span class="attribution-location">Western Cape Gateway Installation</span>
        </div>
      </div>

      <!-- Compact Horizontal Stat Bar -->
      <div class="horizontal-stat-bar">
        <div class="stat-item">
          <span class="stat-label">Location</span>
          <span class="stat-value">Buh-Rein / George</span>
        </div>
        <div class="stat-divider" aria-hidden="true">·</div>
        <div class="stat-item">
          <span class="stat-label">Enclosure</span>
          <span class="stat-value">IP65 Aluminium</span>
        </div>
        <div class="stat-divider" aria-hidden="true">·</div>
        <div class="stat-item">
          <span class="stat-label">Dimming</span>
          <span class="stat-value">Auto Lux-Sensor</span>
        </div>
        <div class="stat-divider" aria-hidden="true">·</div>
        <div class="stat-item">
          <span class="stat-label">Hardware Uptime</span>
          <span class="stat-value tabular-num">99.9%</span>
        </div>
      </div>

      <!-- Subtle Expandable Technical Summary -->
      <details class="minimal-transcript">
        <summary class="transcript-toggle">
          <span>Read Technical Site Survey & Installation Summary</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="transcript-body">
          <p>
            <strong>The Property Brief:</strong> {project.brief}
          </p>
          <p>
            <strong>Engineering Execution:</strong> {project.sightlineExecution}
          </p>
          <p>
            <strong>Daily Operational Outcome:</strong> {project.outcome}
          </p>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .case-study-header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .case-study-layout {
    max-width: 1040px;
    margin-inline: auto;
  }

  .video-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-bg-obsidian);
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--color-border-hairline);
    margin-bottom: 2.5rem;
  }

  .video-player {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .editorial-quote-wrap {
    margin-bottom: 2.5rem;
    text-align: left;
    padding-left: clamp(1rem, 3vw, 2rem);
    border-left: 2px solid var(--color-text-primary);
  }

  .editorial-pull-quote {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 1.45;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
    font-style: normal;
  }

  .quote-attribution {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .attribution-title {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .attribution-location {
    color: var(--color-text-muted);
  }

  .attribution-location::before {
    content: "— ";
  }

  .horizontal-stat-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border-hairline);
    border-bottom: 1px solid var(--color-border-hairline);
    margin-bottom: 2rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media (min-width: 640px) {
    .stat-item {
      flex-direction: row;
      align-items: baseline;
      gap: 0.5rem;
    }
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .stat-value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .stat-divider {
    color: var(--color-border-hairline);
    font-size: 1.25rem;
    display: none;
  }

  @media (min-width: 768px) {
    .stat-divider {
      display: inline-block;
    }
  }

  .minimal-transcript {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .transcript-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    user-select: none;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    min-height: 44px;
  }

  .transcript-toggle:hover {
    color: var(--color-text-primary);
  }

  .minimal-transcript[open] .transcript-toggle svg {
    transform: rotate(180deg);
  }

  .transcript-body {
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    line-height: 1.6;
  }

  .transcript-body strong {
    color: var(--color-text-primary);
  }
</style>
