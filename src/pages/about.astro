---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import rigging from '../assets/rigging.jpg';
import installation01 from '../assets/installation-01.jpg';
import installation03 from '../assets/installation-03.jpg';

const { brand, contact, coverage, method, site } = siteConfig;

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Studio',
      item: new URL('/about', site.url).toString(),
    },
  ],
};

const aboutPage = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `Studio and coverage — ${brand.name}`,
  about: { '@id': `${site.url}/#organisation` },
};
---

<BaseLayout
  title={`Studio & coverage — ${brand.name}`}
  description="A LED display survey and installation practice based in George, Western Cape: how we work, where we work, and the standards each installation is measured against."
  path="/about"
  jsonLd={[breadcrumbs, aboutPage]}
>
  <section class="about-hero" aria-labelledby="about-heading">
    <div class="container">
      <div class="split split--5-7 about-hero__split">
        <div>
          <p class="eyebrow">Studio — established {brand.establishedYear}</p>
          <h1 id="about-heading" class="about-hero__heading">
            A survey practice, not a signage broker.
          </h1>
        </div>
        <div class="about-hero__intro">
          <p class="lede">
            We are a display contractor based in George. The work starts with a measured site visit
            and ends with an electrical certificate and a trained operator — the hardware in between
            is the part everybody talks about, and the part that matters least on its own.
          </p>
          <p>
            Estates and precincts are usually sold a screen and then left to coordinate a steel
            fabricator, an electrician and a content vendor. We take that coordination as one
            contract, because the failure modes live in the seams between those trades: a mount that
            was never wind-loaded, a circuit that was never certified, a CMS nobody was trained on.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-practice" aria-labelledby="practice-heading">
    <div class="container">
      <div class="split split--4-8">
        <div class="about-practice__aside sticky-host">
          <div class="sticky">
            <p class="section__index">
              <span>01</span>
              <span>Practice</span>
            </p>
            <h2 id="practice-heading">How the work is structured.</h2>
            <dl class="register about-practice__register">
              <div class="register__row">
                <dt class="register__label">Hub</dt>
                <dd class="register__value">{coverage.primaryHub}</dd>
              </div>
              <div class="register__row">
                <dt class="register__label">Established</dt>
                <dd class="register__value numeric">{brand.establishedYear}</dd>
              </div>
              <div class="register__row">
                <dt class="register__label">Practice</dt>
                <dd class="register__value">Survey · engineer · install · certify</dd>
              </div>
              <div class="register__row">
                <dt class="register__label">Hours</dt>
                <dd class="register__value">{contact.operatingHours}</dd>
              </div>
            </dl>
          </div>
        </div>

        <div class="about-practice__body">
          <div class="about-practice__prose">
            <p>
              Every project begins with a physical survey: sightline geometry, the solar load the
              screen will face, the substrate it will hang from, and the distance to a dedicated
              circuit. Those four measurements decide the specification. Without them a quote is a
              guess with a letterhead.
            </p>
            <p>
              The survey becomes an itemised scope with structural drawings and SANS 10160 wind-load
              calculations — a document a body corporate can put to a vote, or a landlord can sign,
              without commissioning a second opinion. Installation follows that document, and the
              electrical work is certified under SANS 10142-1 before handover.
            </p>
            <p>
              We specify the hardware under our own name and disclose the panel-level detail to the
              client in the engineering pack. What we do not do is publish a supplier's brand as if
              it were our own engineering.
            </p>
          </div>

          <figure class="plate about-practice__plate">
            <div class="plate__frame about-practice__frame">
              <Image
                src={rigging}
                alt="Technician rigging an outdoor LED display cabinet onto a structural mounting frame."
                widths={[480, 720, 960, 1280]}
                sizes="(max-width: 1023px) 92vw, 58vw"
                loading="lazy"
              />
            </div>
            <figcaption>
              <span class="plate__label">Cabinet rigging, on site</span>
              <span>Cabinets hang on engineered steel, not on the cladding.</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--stone about-coverage" aria-labelledby="coverage-heading">
    <div class="container">
      <div class="split split--4-8 about-coverage__head">
        <div>
          <p class="section__index">
            <span>02</span>
            <span>Coverage</span>
          </p>
          <h2 id="coverage-heading">Where we survey.</h2>
        </div>
        <p class="section__lede">{coverage.notice}</p>
      </div>

      <ul class="about-coverage__list" role="list">
        {coverage.regions.map((region, index) => (
          <li>
            <span class="mono numeric">{String(index + 1).padStart(2, '0')}</span>
            <span>{region}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section about-record" aria-labelledby="record-heading">
    <div class="container">
      <div class="split split--4-8 about-record__head">
        <div>
          <p class="section__index">
            <span>03</span>
            <span>Field record</span>
          </p>
          <h2 id="record-heading">Reference installation.</h2>
        </div>
        <div>
          <p class="section__lede">
            Photographs from the George installation and the surrounding works. One site, recorded
            across the install rather than staged for a brochure.
          </p>
          <p class="small about-record__note">
            Estate identity is withheld at the client's request. Reference installation, George,
            Western Cape.
          </p>
        </div>
      </div>

      <div class="about-record__grid">
        <figure class="plate">
          <div class="plate__frame about-record__frame">
            <Image
              src={installation01}
              alt="The LED cabinet fixed to the estate wall before commissioning, with the screen unlit."
              widths={[520, 760, 960, 1280]}
              sizes="(max-width: 767px) 92vw, 44vw"
              loading="lazy"
            />
          </div>
          <figcaption>
            <span class="plate__label">Cabinet installed, awaiting commissioning</span>
            <span>Cabling and power terminated before the screen is energised.</span>
          </figcaption>
        </figure>

        <figure class="plate">
          <div class="plate__frame about-record__frame about-record__frame--after">
            <Image
              src={installation03}
              alt="The commissioned display showing a golf broadcast, with planted landscaping in front of the wall."
              widths={[520, 760, 960]}
              sizes="(max-width: 767px) 92vw, 44vw"
              loading="lazy"
            />
          </div>
          <figcaption>
            <span class="plate__label">Commissioned display in service, George</span>
            <span>Security alerts, outages and AGM notices in one channel.</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--stone about-standards" aria-labelledby="standards-heading">
    <div class="container">
      <div class="split split--4-8 about-standards__head">
        <div>
          <p class="section__index">
            <span>04</span>
            <span>Standards</span>
          </p>
          <h2 id="standards-heading">Measurements, not adjectives.</h2>
        </div>
        <p class="section__lede">
          Each installation is measured against the same four instruments. They are quoted by number
          because a claim you cannot inspect is not a specification.
        </p>
      </div>

      <ul class="about-standards__list" role="list">
        {method.standards.map((standard) => (
          <li>
            <span class="badge badge--ok">{standard.code}</span>
            <h3 class="about-standards__title">{standard.label}</h3>
            <p>{standard.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section about-cta" aria-labelledby="about-cta-heading">
    <div class="container">
      <div class="split split--7-5">
        <div>
          <p class="section__index">
            <span>05</span>
            <span>Next</span>
          </p>
          <h2 id="about-cta-heading">Commission a survey.</h2>
          <p class="about-cta__body">
            Send the property, the town and the problem the display has to solve. If a physical
            survey is warranted we will schedule it; if it is not, we will say so.
          </p>
        </div>
        <div class="about-cta__actions">
          <a class="btn" href="/#commission">
            Start an enquiry
          </a>
          <a class="btn btn--ghost" href={`tel:${contact.phoneDial}`}>
            {contact.phoneDisplay}
          </a>
          <a class="arrow-link about-cta__link" href={`mailto:${contact.emailQuote}`}>
            {contact.emailQuote}
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.25"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding-top: calc(var(--header-h) + clamp(40px, 6vw, 88px));
    padding-bottom: clamp(48px, 6vw, 88px);
    border-bottom: 1px solid var(--rule);
  }

  .about-hero__heading {
    margin-top: 18px;
    max-width: 12ch;
  }

  .about-hero__intro {
    display: grid;
    gap: 18px;
    padding-top: 6px;
  }

  .about-hero__intro p {
    color: var(--text-2);
  }

  .about-practice__register {
    margin-top: 24px;
  }

  .about-practice__prose {
    display: grid;
    gap: 16px;
    color: var(--text-2);
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: 66ch;
  }

  .about-practice__plate {
    margin-top: clamp(28px, 3vw, 40px);
  }

  .about-practice__frame {
    aspect-ratio: 4 / 3;
  }

  .about-coverage__head,
  .about-record__head,
  .about-standards__head {
    margin-bottom: clamp(28px, 3.4vw, 44px);
  }

  .about-coverage__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }

  .about-coverage__list li {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 16px 20px 16px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .about-coverage__list .mono {
    color: var(--accent-text);
  }

  .about-record__note {
    margin-top: 12px;
  }

  /* Before → after diptych: both plates are landscape and share one ratio,
     so neither subject is squeezed into a portrait crop. */
  .about-record__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter-x);
  }

  .about-record__frame {
    aspect-ratio: 4 / 3;
  }

  .about-record__frame img {
    object-position: center;
  }

  /* The commissioned shot is a portrait original: bias the crop onto the wall
     and display band rather than the sky above it. */
  .about-record__frame--after img {
    object-position: center 44%;
  }

  .about-standards__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule-strong);
  }

  .about-standards__list li {
    padding: 20px 20px 12px 0;
    border-right: 1px solid var(--rule);
  }

  .about-standards__list li:last-child {
    border-right: 0;
  }

  .about-standards__list li:not(:first-child) {
    padding-left: 20px;
  }

  .about-standards__title {
    margin-top: 12px;
    font-size: var(--step-1);
  }

  .about-standards__list p {
    margin-top: 8px;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--text-3);
  }

  .about-cta__body {
    margin-top: 18px;
    max-width: 46ch;
    color: var(--text-2);
  }

  .about-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    padding-top: 6px;
  }

  .about-cta__link {
    flex-basis: 100%;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  @media (max-width: 767px) {
    .about-record__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 1023px) {
    .about-standards__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about-standards__list li:nth-child(2) {
      border-right: 0;
    }
  }

  @media (max-width: 767px) {
    .about-coverage__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .about-standards__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .about-standards__list li {
      border-right: 0;
      padding: 18px 0;
      border-bottom: 1px solid var(--rule);
    }
    .about-standards__list li:not(:first-child) {
      padding-left: 0;
    }
  }
</style>
