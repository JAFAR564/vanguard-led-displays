---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSplit from '../components/HeroSplit.astro';
import Applications from '../components/Applications.astro';
import CaseStudy from '../components/CaseStudy.astro';
import MethodCompliance from '../components/MethodCompliance.astro';
import Specifications from '../components/Specifications.astro';
import CommercialModels from '../components/CommercialModels.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import InquirySection from '../components/InquirySection.astro';
import { siteConfig } from '../config/site';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: siteConfig.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Turnkey LED display installation',
  serviceType: 'LED display survey, engineering, installation and certification',
  provider: { '@id': `${siteConfig.site.url}/#organisation` },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Western Cape' },
    { '@type': 'Country', name: 'South Africa' },
  ],
  description:
    'Survey, structural mounting, SANS-compliant electrical installation, CMS commissioning and operator handover for estates and commercial precincts.',
  audience: {
    '@type': 'Audience',
    audienceType: 'Residential estates, body corporates and commercial property owners',
  },
};

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: siteConfig.caseStudy.video.caption,
  description: siteConfig.caseStudy.lede,
  thumbnailUrl: new URL('/assets/og-image.jpg', siteConfig.site.url).toString(),
  contentUrl: new URL(siteConfig.caseStudy.video.src, siteConfig.site.url).toString(),
  uploadDate: '2025-01-01',
};

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.site.url }],
};
---

<BaseLayout jsonLd={[faqSchema, serviceSchema, videoSchema, breadcrumbs]}>
  <HeroSplit />
  <Applications />
  <CaseStudy />
  <MethodCompliance />
  <Specifications />
  <CommercialModels />
  <FaqAccordion />
  <InquirySection />
</BaseLayout>
