---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ScrollScrubHero from '../components/ScrollScrubHero.astro';
import UseCaseCards from '../components/UseCaseCards.astro';
import VideoProofPlayer from '../components/VideoProofPlayer.astro';
import SolutionMatrix from '../components/SolutionMatrix.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import TrustSupportGrid from '../components/TrustSupportGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import PropertyQuoteForm from '../components/PropertyQuoteForm.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileStickyCta from '../components/MobileStickyCta.astro';
---

<BaseLayout>
  <!-- 01. Global Minimal Header -->
  <SiteHeader />

  <!-- Main Content Container with Landmark for Accessibility -->
  <main id="main-content">
    <!-- 02. Architectural Scrollytelling Hero (60fps Canvas Scrub Engine) -->
    <ScrollScrubHero />

    <!-- 03. Editorial Applications Split -->
    <UseCaseCards />

    <!-- 04. Case Study Showcase -->
    <VideoProofPlayer />

    <!-- 05. Borderless Comparison Table -->
    <SolutionMatrix />

    <!-- 06. 4-Stage Delivery Methodology -->
    <ProcessTimeline />

    <!-- 07. Hardware Chassis System Architecture -->
    <TrustSupportGrid />

    <!-- 08. Governance & Pre-Assessment FAQ -->
    <FaqAccordion />

    <!-- 09. Unified Segmented Consultation & Media Inquiries -->
    <PropertyQuoteForm />
  </main>

  <!-- 10. Corporate Footer & Disclosures -->
  <SiteFooter />

  <!-- Mobile Ergonomics: Fixed Bottom Action Bar (< 768px) with Auto-Hide -->
  <MobileStickyCta />
</BaseLayout>
